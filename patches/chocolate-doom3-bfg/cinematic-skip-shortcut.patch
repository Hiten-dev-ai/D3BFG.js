+/*
+================
+idGameLocal::SkipCinematic
+================
+*/
+bool idGameLocal::SkipCinematic()
+{
+    if (!inCinematic || time < cinematicSkipTime) {
+        return false;
+    }
+
+    if (camera) {
+        if (camera->spawnArgs.GetBool("disconnect")) {
+            camera->spawnArgs.SetBool("disconnect", false);
+            cvarSystem->SetCVarFloat("r_znear", 3.0f);
+            cmdSystem->BufferCommandText(CMD_EXEC_APPEND, "disconnect\n");
+            skipCinematic = false;
+            return false;
+        }
+        if (camera->spawnArgs.GetBool("instantSkip")) {
+            camera->Stop();
+            return false;
+        }
+    }
+
+    soundSystem->SetMute(true);
+    if (!skipCinematic) {
+        skipCinematic = true;
+        cinematicMaxSkipTime = time + SEC2MS(g_cinematicMaxSkipTime.GetFloat());
+        idSoundWorld* playingSoundWorld = soundSystem->GetPlayingSoundWorld();
+        if (playingSoundWorld) {
+            playingSoundWorld->Skip(cinematicMaxSkipTime);
+        }
+    }
+    return true;
+}
+
+bool idGameLocal::SkipCinematicScene()
+{
+    return SkipCinematic();
+}
+
+bool idGameLocal::CheckInCinematic()
+{
+    return inCinematic;
+}
