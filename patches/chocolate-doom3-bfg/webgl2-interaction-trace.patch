+#if defined(__EMSCRIPTEN__)
+static int RB_WebPortCountInteractionSurfaces(const drawSurf_t* surfList)
+{
+    int count = 0;
+    for (const drawSurf_t* surf = surfList; surf != NULL && count < 65535; surf = surf->nextOnLight) {
+        count++;
+    }
+    return count;
+}
+#endif
+
 static void RB_DrawInteractions()
 {
     if (r_skipInteractions.GetBool()) {
@@ -1919,6 +1940,17 @@ static void RB_DrawInteractions()
     renderLog.OpenMainBlock(MRB_DRAW_INTERACTIONS);
     renderLog.OpenBlock("RB_DrawInteractions");
 
+#if defined(__EMSCRIPTEN__)
+    static int webPortInteractionTraceFrames = 0;
+    const bool traceWebPortInteractions = r_webPortPassTrace.GetBool() && webPortInteractionTraceFrames < 1;
+    int webPortLightCount = 0;
+    int webPortLightsWithInteractions = 0;
+    int webPortLocalInteractionCount = 0;
+    int webPortGlobalInteractionCount = 0;
+    int webPortTranslucentInteractionCount = 0;
+    int webPortLoggedLights = 0;
+#endif
+
     GL_SelectTexture(0);
 
     const bool useLightDepthBounds = r_useLightDepthBounds.GetBool();
@@ -1927,6 +1959,31 @@ static void RB_DrawInteractions()
     // for each light, perform shadowing and adding
     //
     for (const viewLight_t* vLight = backEnd.viewDef->viewLights; vLight != NULL; vLight = vLight->next) {
+#if defined(__EMSCRIPTEN__)
+        if (traceWebPortInteractions) {
+            const int localCount = RB_WebPortCountInteractionSurfaces(vLight->localInteractions);
+            const int globalCount = RB_WebPortCountInteractionSurfaces(vLight->globalInteractions);
+            const int translucentCount = RB_WebPortCountInteractionSurfaces(vLight->translucentInteractions);
+            webPortLightCount++;
+            webPortLocalInteractionCount += localCount;
+            webPortGlobalInteractionCount += globalCount;
+            webPortTranslucentInteractionCount += translucentCount;
+            if (localCount + globalCount + translucentCount > 0) {
+                webPortLightsWithInteractions++;
+                if (webPortLoggedLights < 12) {
+                    const drawSurf_t* firstSurf = vLight->localInteractions != NULL ? vLight->localInteractions :
+                        (vLight->globalInteractions != NULL ? vLight->globalInteractions : vLight->translucentInteractions);
+                    common->Printf("[web-port lighting] light=%d shader=%s falloff=%s scissor=%d,%d-%d,%d local=%d global=%d translucent=%d surface=%s stages=%d\n",
+                        webPortLightCount, vLight->lightShader->GetName(), vLight->falloffImage != NULL ? vLight->falloffImage->GetName() : "null",
+                        vLight->scissorRect.x1, vLight->scissorRect.y1, vLight->scissorRect.x2, vLight->scissorRect.y2,
+                        localCount, globalCount, translucentCount,
+                        firstSurf != NULL && firstSurf->material != NULL ? firstSurf->material->GetName() : "null",
+                        vLight->lightShader->GetNumStages());
+                    webPortLoggedLights++;
+                }
+            }
+        }
+#endif
         // do fogging later
         if (vLight->lightShader->IsFogLight()) {
             continue;
@@ -2027,6 +2084,14 @@ static void RB_DrawInteractions()
         renderLog.CloseBlock();
     }
 
+#if defined(__EMSCRIPTEN__)
+    if (traceWebPortInteractions) {
+        common->Printf("[web-port lighting] summary lights=%d active=%d local=%d global=%d translucent=%d\n",
+            webPortLightCount, webPortLightsWithInteractions, webPortLocalInteractionCount, webPortGlobalInteractionCount, webPortTranslucentInteractionCount);
+        webPortInteractionTraceFrames++;
+    }
+#endif
