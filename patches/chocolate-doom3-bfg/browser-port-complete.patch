+            return idSWFScriptVar();
+        }
+        idStr action;
+    };
+    idStaticList<idSWFScriptFunction*, 4> callbacks;
+    idStaticList<idStrId, 4> labels;
+    const bool clearData = idStr::Icmp(action, "clearData") == 0;
+    callbacks.Append(new ConfirmAction(clearData ? "" : action));
+    callbacks.Append(new ConfirmAction(clearData ? action : ""));
+    labels.Append(idLocalization::AddString(clearData ? "Cancel" : "Restart now"));
+    labels.Append(idLocalization::AddString(clearData ? "Clear local data" : "Restart later"));
+    common->Dialog().AddDynamicDialog(GDM_GAME_RESTART_REQUIRED, callbacks, labels, true,
+        idStr(clearData
+            ? "Clear all local game data, including saves, profile, and trusted login from this browser?"
+            : idStr::Icmp(action, "clearAssetCache") == 0
+                ? "Clear cached game assets and restart? Saved games and profiles are kept."
+                : "Restart the game to apply these settings? Save your progress before restarting."));
