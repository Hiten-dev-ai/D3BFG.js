+#ifdef __EMSCRIPTEN__
+#include <errno.h>
+#include <sys/stat.h>
+#include <emscripten.h>
+
+// OpenFileRead() returns NULL for both a missing file and other open failures.
+// A missing first-run profile is expected, but an existing unreadable profile
+// must still be reported as corrupt instead of being silently replaced.
+static saveGameError_t ClassifyBrowserProfileOpenFailure(int statResult, int statError)
+{
+    return statResult == -1 && statError == ENOENT
+        ? SAVEGAME_E_FILE_NOT_FOUND
+        : SAVEGAME_E_CORRUPTED;
+}
+
+EM_ASYNC_JS(int, WebFlushBrowserSaveData, (), {
+  if (Module['persistSaves'] === false) return 1;
+  try {
+    const saveMount = FS.getMounts(FS.root.mount).find((mount) => mount.mountpoint === '/doom3_save_data');
+    if (!saveMount || !saveMount.type || typeof saveMount.type.syncfs !== 'function') {
+      throw new Error('IDBFS save mount is unavailable.');
+    }
+
+    const deadline = Date.now() + 60000;
+    while (saveMount.idbPersistState) {
+      if (Date.now() >= deadline) throw new Error('IDBFS auto-persist did not settle before timeout.');
+      await new Promise((resolve) => setTimeout(resolve, 0));
+    }
+
+    await new Promise((resolve, reject) => {
+      let settled = false;
+      const finish = (error) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        if (error) reject(error);
+        else resolve();
+      };
+      const timer = setTimeout(
+        () => finish(new Error('IDBFS save sync did not complete before timeout.')),
+        Math.max(0, deadline - Date.now())
+      );
+      try {
+        saveMount.type.syncfs(saveMount, false, finish);
+      } catch (error) {
+        finish(error);
+      }
+    });
+    return 1;
+  } catch (error) {
+    err('[DOOM 3 BFG Web] IDBFS save barrier failed: ' + String(error));
+    return 0;
