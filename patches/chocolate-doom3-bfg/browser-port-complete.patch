+bool idMenuScreen_Shell_WebMultiplayer::HandleBrowserInput(const sysEvent_t* event)
+{
+    if (!event || !menuData || menuData->ActiveScreen() != SHELL_AREA_MODE_SELECT) return false;
+    // Escape is navigation, not an edit key held across page changes. A release
+    // can go to a different screen/dialog, so retaining it here swallowed the
+    // next Escape press when multiplayer was reopened.
+    if (event->evType == SE_KEY && event->evValue == K_ESCAPE) {
+        const int held = multiplayerEditConsumedKeys.FindIndex(K_ESCAPE);
+        if (held >= 0) multiplayerEditConsumedKeys.RemoveIndex(held);
+        if (event->evValue2) Back();
+        return true;
+    }
+    if (event->evType == SE_KEY) {
+        const int held = multiplayerEditConsumedKeys.FindIndex(event->evValue);
+        if (held >= 0 && !event->evValue2) { multiplayerEditConsumedKeys.RemoveIndex(held); return true; }
+        if (held >= 0 && editing == EDIT_NONE) return true;
+    }
+    if (event->evType == SE_KEY && event->evValue2 != 0) {
+        if (editing == EDIT_NONE) return false;
+        if (event->evValue == K_A && (idKeyInput::IsDown(K_LCTRL) || idKeyInput::IsDown(K_RCTRL))) {
+            (editing == EDIT_NAME ? lobbyName : privateCode).Clear();
+            multiplayerEditConsumedKeys.AddUnique(event->evValue);
+            UpdateEditLabel();
+            return true;
+        }
+        if (event->evValue == K_ENTER || event->evValue == K_KP_ENTER) {
+            multiplayerEditConsumedKeys.AddUnique(event->evValue);
+            if (editing == EDIT_CODE) SubmitJoinCode();
+            else { editing = EDIT_NONE; UpdateEditLabel(); }
+            SetFocusIndex(0, true);
+            if (options) options->SetFocusIndex(options->GetViewIndex() - options->GetViewOffset(), true);
+            return true;
+        }
+        if (event->evValue == K_BACKSPACE) {
+            idStr& value = editing == EDIT_NAME ? lobbyName : privateCode;
+            if (value.Length() > 0) value.CapLength(value.Length() - 1);
+            UpdateEditLabel();
+            if (options) options->Update();
+            return true;
+        }
+        return false;
+    }
+    if (event->evType == SE_CHAR && editing != EDIT_NONE) {
+        if (idKeyInput::IsDown(K_LCTRL) || idKeyInput::IsDown(K_RCTRL)) return true;
+        const int ch = event->evValue;
+        if (ch < 32 || ch > 126 || ch == '|') return true;
+        idStr& value = editing == EDIT_NAME ? lobbyName : privateCode;
+        const int limit = editing == EDIT_NAME ? 48 : 64;
+        if (value.Length() < limit) {
+            if (editing == EDIT_CODE && !((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+                (ch >= '0' && ch <= '9') || ch == '-' || ch == '_')) return true;
+            value.Append(static_cast<char>(ch));
+            UpdateEditLabel();
+        }
+        return true;
+    }
+    return false;
+}
+
+bool idMenuScreen_Shell_WebMultiplayer::HandleAction(idWidgetAction& action, const idWidgetEvent& event, idMenuWidget* widget, bool forceHandled)
+{
+    if (!menuData || menuData->ActiveScreen() != SHELL_AREA_MODE_SELECT) return false;
+    struct ActionTrace {
+        int start, command, page;
+        ActionTrace(int cmd, int current) : start(Sys_Milliseconds()), command(cmd), page(current) {}
+        ~ActionTrace() {
+            if (command >= 0) common->Printf("[web-port menu] multiplayer action=%d page=%d elapsed=%d ms\n", command, page, Sys_Milliseconds() - start);
+        }
+    } trace(action.GetType() == WIDGET_ACTION_GO_BACK ? MP_CMD_BACK :
+        action.GetType() == WIDGET_ACTION_COMMAND && action.GetParms().Num() ? action.GetParms()[0].ToInteger() : -1, page);
+    if (action.GetType() == WIDGET_ACTION_GO_BACK) {
+        Back();
+        return true;
+    }
+    if (action.GetType() != WIDGET_ACTION_COMMAND || !action.GetParms().Num()) {
+        return idMenuWidget::HandleAction(action, event, widget, forceHandled);
+    }
+
+    const int command = action.GetParms()[0].ToInteger();
+    const int status = BrowserBridge_GetNumber("mpStatus");
+    if (command == MP_CMD_CONNECT) {
+        BrowserBridge_Action("mpConnect");
+    } else if (command == MP_CMD_PRIVACY) {
+        AdjustField(command, 1);
+    } else if (command == MP_CMD_CREATE || command == MP_CMD_COOP_CREATE || command == MP_CMD_COOP_DEV) {
+        if (command == MP_CMD_COOP_DEV && BrowserBridge_GetNumber("mpInRoom") && BrowserBridge_GetNumber("mpIsHost")) {
+            coopDevChoice = true;
+            BrowserBridge_Action("mpOpenCoopDevPicker");
+            menuData->SetNextScreen(SHELL_AREA_DEV, MENU_TRANSITION_SIMPLE);
+            return true;
+        }
+        const bool coop = command != MP_CMD_CREATE;
+        coopDevChoice = command == MP_CMD_COOP_DEV;
+        coopFlow = coop;
+        coopFlow = coop;
+        page = PAGE_CREATE;
+        if (lobbyName.Length() == 0) lobbyName = va("%s's game", BrowserBridge_GetText("profileName", "Marine").c_str());
+        BuildPage();
+    } else if (command == MP_CMD_JOIN || command == MP_CMD_COOP_JOIN) {
+        const int kind = command == MP_CMD_COOP_JOIN ? 1 : 0;
+        coopFlow = kind == 1;
+        RequestJoinList(kind);
+        BuildPage();
+    } else if (command == MP_CMD_COOP) {
+        coopFlow = true;
+        page = PAGE_COOP;
+        BuildPage();
+    } else if (command == MP_CMD_NAME) {
+        BeginEdit(EDIT_NAME);
+    } else if (command == MP_CMD_MODE) {
+        AdjustField(command, 1);
+    } else if (command == MP_CMD_MAP) {
+        AdjustField(command, 1);
+    } else if (command == MP_CMD_PLAYERS) {
+        AdjustField(command, 1);
+    } else if (command == MP_CMD_LIVES || command == MP_CMD_FRIENDLY_FIRE) {
+        AdjustField(command, 1);
+    } else if (command == MP_CMD_CREATE_SUBMIT) {
+        SubmitCreate();
+        BuildPage();
+    } else if (command == MP_CMD_CODE) {
+        BeginEdit(EDIT_CODE);
+    } else if (command == MP_CMD_REFRESH) {
+        RequestJoinList(joinPageKind);
+        BuildPage();
+    } else if (command == MP_CMD_RECONNECT) {
+        BrowserBridge_Action("mpReconnect");
+        BuildPage();
+    } else if (command == MP_CMD_COPY_CODE) {
+        // The page copies the code and queues the "Copied to clipboard"
+        // confirmation, which the shell shows in its native dialog.
+        BrowserBridge_Action("mpCopyCode");
+    } else if (command == MP_CMD_BACK) {
+        Back();
+    } else if (command == MP_CMD_ROOM_PRIVACY) {
+        BrowserBridge_Action("mpTogglePrivacy");
+    } else if (command == MP_CMD_START) {
+        if (BrowserBridge_GetNumber("mpRoomKind") == 1) {
+            const int state = cvarSystem->GetCVarInteger("web_coop_save_state");
+            if (state == 2 &&
+                BrowserBridge_GetNumber("mpIsHost") && BrowserBridge_GetNumber("mpRoomPlayers") >= 1) {
+                BrowserBridge_Action("mpStart");
+            }
+        } else if (BrowserBridge_GetNumber("mpPeerId") == BrowserBridge_GetNumber("mpHostPeerId") &&
+            BrowserBridge_GetNumber("mpInRoom") && BrowserBridge_GetNumber("mpRoomPlayers") >= 2 &&
+            !BrowserBridge_GetNumber("mpStarted")) {
+            BrowserBridge_Action("mpStart");
+        }
+    } else if (command == MP_CMD_LEAVE) {
+        Back();
+    } else if (command == MP_CMD_CONTINUE) {
+        if (BrowserBridge_GetNumber("mpIsHost")) {
+            pendingCoopSaveCommand = MP_CMD_CONTINUE;
+            autoStartCoop = true;
+            BuildPage();
+        } else {
+            localError = "No usable campaign save is available.";
+            BuildPage();
+        }
+    } else if (command == MP_CMD_LOAD_SAVE) {
+        if (BrowserBridge_GetNumber("mpIsHost")) {
+            pendingCoopSaveCommand = MP_CMD_LOAD_SAVE;
+            autoStartCoop = true;
+            BuildPage();
+            return true;
+        }
+        BrowserBridge_Action("mpOpenCoopSavePicker");
+        if (BrowserBridge_GetNumber("mpCoopSavePicker") && menuData) {
+            menuData->SetNextScreen(SHELL_AREA_LOAD, MENU_TRANSITION_SIMPLE);
+        } else {
+            localError = "Only the co-op host can choose a campaign save.";
+            BuildPage();
+        }
+    } else if (command >= MP_CMD_LOBBY_BASE) {
+        const int index = command - MP_CMD_LOBBY_BASE;
+        const idStr lobbyId = BrowserBridge_GetText(va("mpLobbyId%d", index), "");
+        if (lobbyId.Length() && lobbyId.Length() <= 64 && !ContainsCharacter(lobbyId.c_str(), '|')) {
+            BrowserBridge_Action(va("mpJoin|%s", lobbyId.c_str()));
+        }
+    }
+    return true;
+}
