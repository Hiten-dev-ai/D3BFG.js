+    case SDL_CONTROLLER_BUTTON_B: return K_JOY2;
+    case SDL_CONTROLLER_BUTTON_X: return K_JOY3;
+    case SDL_CONTROLLER_BUTTON_Y: return K_JOY4;
+    case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: return K_JOY5;
+    case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: return K_JOY6;
+    case SDL_CONTROLLER_BUTTON_LEFTSTICK: return K_JOY7;
+    case SDL_CONTROLLER_BUTTON_RIGHTSTICK: return K_JOY8;
+    case SDL_CONTROLLER_BUTTON_START: return K_JOY9;
+    case SDL_CONTROLLER_BUTTON_BACK: return K_JOY10;
+    case SDL_CONTROLLER_BUTTON_DPAD_UP: return K_JOY_DPAD_UP;
+    case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return K_JOY_DPAD_DOWN;
+    case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return K_JOY_DPAD_LEFT;
+    case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return K_JOY_DPAD_RIGHT;
+    default: return 0;
+    }
+}
+
+static int GameControllerAction(SDL_GameControllerButton button)
+{
+    switch (button) {
+    case SDL_CONTROLLER_BUTTON_A: return J_ACTION1;
+    case SDL_CONTROLLER_BUTTON_B: return J_ACTION2;
+    case SDL_CONTROLLER_BUTTON_X: return J_ACTION3;
+    case SDL_CONTROLLER_BUTTON_Y: return J_ACTION4;
+    case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: return J_ACTION5;
+    case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: return J_ACTION6;
+    case SDL_CONTROLLER_BUTTON_LEFTSTICK: return J_ACTION7;
+    case SDL_CONTROLLER_BUTTON_RIGHTSTICK: return J_ACTION8;
+    case SDL_CONTROLLER_BUTTON_START: return J_ACTION9;
+    case SDL_CONTROLLER_BUTTON_BACK: return J_ACTION10;
+    case SDL_CONTROLLER_BUTTON_DPAD_UP: return J_DPAD_UP;
+    case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return J_DPAD_DOWN;
+    case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return J_DPAD_LEFT;
+    case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return J_DPAD_RIGHT;
+    default: return -1;
+    }
+}
+
+static int GameControllerAxis(SDL_GameControllerAxis axis)
+{
+    switch (axis) {
+    case SDL_CONTROLLER_AXIS_LEFTX: return AXIS_LEFT_X;
+    case SDL_CONTROLLER_AXIS_LEFTY: return AXIS_LEFT_Y;
+    case SDL_CONTROLLER_AXIS_RIGHTX: return AXIS_RIGHT_X;
+    case SDL_CONTROLLER_AXIS_RIGHTY: return AXIS_RIGHT_Y;
+    case SDL_CONTROLLER_AXIS_TRIGGERLEFT: return AXIS_LEFT_TRIG;
+    case SDL_CONTROLLER_AXIS_TRIGGERRIGHT: return AXIS_RIGHT_TRIG;
+    default: return -1;
+    }
+}
+
+static void ResetGameControllerState(int slot)
+{
+    for (int button = 0; button < SDL_CONTROLLER_BUTTON_MAX; ++button) {
+        const SDL_GameControllerButton mappedButton = static_cast<SDL_GameControllerButton>(button);
+        const int key = GameControllerKey(mappedButton);
+        const int action = GameControllerAction(mappedButton);
+        if (gameControllerKeyButtons[slot][button] && key != 0) {
+            QueueControllerKey(slot, key, false);
+        }
+        if (gameControllerPollButtons[slot][button] && action >= 0) {
+            QueueControllerPollEvent(slot, action, 0, true);
+        }
+        gameControllerKeyButtons[slot][button] = false;
+        gameControllerPollButtons[slot][button] = false;
+    }
+
+    for (int axis = 0; axis < MAX_JOYSTICK_AXIS; ++axis) {
+        if (gameControllerEventAxes[slot][axis] != 0) {
+            QueueControllerJoystickEvent(slot, axis, 0);
+        }
+        if (gameControllerPollAxes[slot][axis] != 0) {
+            QueueControllerPollEvent(slot, J_AXIS_MIN + axis, 0, true);
+        }
+        gameControllerEventAxes[slot][axis] = 0;
+        gameControllerPollAxes[slot][axis] = 0;
+    }
+
+    for (int trigger = 0; trigger < 2; ++trigger) {
+        if (gameControllerTriggers[slot][trigger]) {
+            QueueControllerKey(slot, trigger == 0 ? K_JOY_TRIGGER1 : K_JOY_TRIGGER2, false);
+        }
+        gameControllerTriggers[slot][trigger] = false;
+    }
