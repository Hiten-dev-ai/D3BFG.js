+idSWFScriptVar idMenuScreen_Shell_WebMultiplayer::GetField(const int field) const
+{
+    const idList<mpMap_t>& maps = common->GetMapList();
+    const idStrList& modes = common->GetModeDisplayList();
+    if (field == MP_CMD_MODE && modes.Num()) return idLocalization::GetString(modes[idMath::ClampInt(0, Min(5, modes.Num()) - 1, modeIndex)]);
+    if (field == MP_CMD_MAP && maps.Num()) return idLocalization::GetString(maps[idMath::ClampInt(0, maps.Num() - 1, mapIndex)].mapName);
+    if (field == MP_CMD_PLAYERS) return va("%d", maxPlayers);
+    if (field == MP_CMD_LIVES) return va("%d", coopLives);
+    if (field == MP_CMD_FRIENDLY_FIRE) return friendlyFire ? "Enabled" : "Disabled";
+    if (field == MP_CMD_PRIVACY) return isPrivate ? "Private" : "Public";
+    return "";
+}
+
+void idMenuScreen_Shell_WebMultiplayer::AdjustField(const int field, const int amount)
+{
+    if (field == MP_CMD_MODE) CycleMode(amount);
+    else if (field == MP_CMD_MAP) CycleMap(amount);
+    else if (field == MP_CMD_PLAYERS) maxPlayers = 2 + ((maxPlayers - 2 + amount) % 7 + 7) % 7;
+    else if (field == MP_CMD_LIVES) coopLives = 1 + ((coopLives - 1 + amount) % 10 + 10) % 10;
+    else if (field == MP_CMD_FRIENDLY_FIRE) friendlyFire = !friendlyFire;
+    else if (field == MP_CMD_PRIVACY) isPrivate = !isPrivate;
+}
+
+void idMenuScreen_Shell_WebMultiplayer::SetHeading(const char* heading)
+{
+    if (pageHeading != heading) pageHeading = heading;
+    idSWFScriptObject& root = GetSWFObject()->GetRootObject();
+    if (!BindSprite(root)) return;
+    idSWFTextInstance* text = GetSprite()->GetScriptObject()->GetNestedText("info", "txtHeading");
+    if (text) {
+        text->SetText(heading);
+        text->SetStrokeInfo(true, 0.75f, 1.75f);
+    }
+    idSWFSpriteInstance* gradient = GetSprite()->GetScriptObject()->GetNestedSprite("info", "gradient");
+    if (gradient && text) gradient->SetXPos(text->GetTextLength());
+}
