+void idMenuScreen_Shell_WebSettings::idMenuDataSource_BrowserSettings::LoadData() {
+    originalCacheMode = BrowserBridge_GetNumber("cacheMode", 1);
+    originalPersistSaves = BrowserBridge_GetNumber("persistSaves", 1);
+    originalEnableConsole = BrowserBridge_GetNumber("enableConsole", 0);
+    originalDeveloperLevels = BrowserBridge_GetNumber("developerMenu", 0);
+    originalSkipIntro = BrowserBridge_GetNumber("skipIntro", 1);
+}
+void idMenuScreen_Shell_WebSettings::idMenuDataSource_BrowserSettings::CommitData() {}
+bool idMenuScreen_Shell_WebSettings::idMenuDataSource_BrowserSettings::IsDataChanged() const {
+    return originalCacheMode != BrowserBridge_GetNumber("cacheMode", 1) ||
+        originalPersistSaves != BrowserBridge_GetNumber("persistSaves", 1) ||
+        originalEnableConsole != BrowserBridge_GetNumber("enableConsole", 0) ||
+        originalDeveloperLevels != BrowserBridge_GetNumber("developerMenu") ||
+        originalSkipIntro != BrowserBridge_GetNumber("skipIntro", 1);
+}
+idSWFScriptVar idMenuScreen_Shell_WebSettings::idMenuDataSource_BrowserSettings::GetField(int field) const {
+    switch (field) {
+    case BROWSER_FIELD_AUDIO_OUTPUT: return BrowserBridge_GetText("audioOutputName", "System default").c_str();
+    case BROWSER_FIELD_CACHE_MODE: {
+        const char* values[] = { "No persistent cache", "Shared assets only", "Visited levels", "All game data" };
+        return values[idMath::ClampInt(0, 3, BrowserBridge_GetNumber("cacheMode", 1))];
+    }
+    case BROWSER_FIELD_PERSIST_SAVES: return BrowserBridge_GetNumber("persistSaves", 1) ? "On" : "Session only";
+    case BROWSER_FIELD_ENABLE_CONSOLE: return BrowserBridge_GetNumber("enableConsole", 0) ? "On" : "Off";
+    case BROWSER_FIELD_DEVELOPER_LEVELS: return BrowserBridge_GetNumber("developerMenu") ? "On" : "Off";
+    case BROWSER_FIELD_SKIP_INTRO: return BrowserBridge_GetNumber("skipIntro", 1) ? "Skip" : "Fast forward";
+    case BROWSER_FIELD_STORAGE_SUMMARY: return BrowserBridge_GetText("storageSummary").c_str();
+    }
+    return false;
+}
+void idMenuScreen_Shell_WebSettings::idMenuDataSource_BrowserSettings::AdjustField(int field, int amount) {
+    if (field == BROWSER_FIELD_AUDIO_OUTPUT) { BrowserBridge_Action(amount < 0 ? "previousAudioOutput" : "selectAudioOutput"); return; }
+    if (field == BROWSER_FIELD_ENABLE_CONSOLE) {
+        BrowserBridge_SetNumber("enableConsole", BrowserBridge_GetNumber("enableConsole", 0) ? 0 : 1);
+        return;
+    }
+    const char* keys[] = { "audioOutput", "cacheMode", "persistSaves", "enableConsole", "developerMenu", "skipIntro" };
+    if (field < 0 || field >= 6) return;
+    const int count = field == BROWSER_FIELD_AUDIO_OUTPUT ? Max(1, BrowserBridge_GetNumber("audioOutputCount", 1)) : field == BROWSER_FIELD_CACHE_MODE ? 4 : 2;
+    const int value = (BrowserBridge_GetNumber(keys[field], field == 1 || field == 2 || field == 3 || field == 5 ? 1 : 0) + amount + count) % count;
+    BrowserBridge_SetNumber(keys[field], value);
+}
+bool idMenuScreen_Shell_WebSettings::idMenuDataSource_BrowserSettings::ClearAssetCache() { BrowserSettingsConfirm("clearAssetCache"); return true; }
