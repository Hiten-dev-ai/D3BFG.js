+/*
+========================
+idMenuScreen_HUD::UpdateCoopLives
+========================
+*/
+void idMenuScreen_HUD::UpdateCoopLives(int lives, int totalLives, bool respawning)
+{
+    if (!mpInfo || !mpTime) {
+        return;
+    }
+
+    lives = idMath::ClampInt(0, 10, lives);
+    totalLives = idMath::ClampInt(1, 10, totalLives);
+    if (!coopLivesTextColorSaved) {
+        coopLivesOriginalColor = mpTime->color;
+        coopLivesTextColorSaved = true;
+    }
+
+    if (coopLivesRemaining != lives || (respawning && !coopRespawnWasActive)) {
+        coopLivesRemaining = lives;
+        // Keep the count fully visible for five seconds, then fade it out over
+        // the final second unless the player is still waiting to respawn.
+        coopLivesShownUntil = gameLocal.time + 6000;
+    }
+    coopRespawnWasActive = respawning;
+
+    const bool visible = respawning || gameLocal.time < coopLivesShownUntil;
+    if (!visible) {
+        mpInfo->SetAlpha(1.0f);
+        mpInfo->SetVisible(false);
+        mpTime->SetText("");
+        mpTime->color = coopLivesOriginalColor;
+        if (respawnMessage && coopRespawnTextColorSaved) {
+            idSWFTextInstance* respawnText = respawnMessage->GetScriptObject()->GetNestedText("info", "txtMessage");
+            if (respawnText) respawnText->color = coopRespawnOriginalColor;
+        }
+        return;
+    }
+
+    ToggleMPInfo(true, false, false);
+    if (mpMessage) {
+        mpMessage->SetText("");
+    }
+    mpTime->SetText(va("LIVES %d/%d", lives, totalLives));
+    mpTime->SetStrokeInfo(true, 0.75f, 1.5f);
+
+    float alpha = 1.0f;
+    if (!respawning && gameLocal.time > coopLivesShownUntil - 1000) {
+        alpha = idMath::ClampFloat(0.0f, 1.0f, (coopLivesShownUntil - gameLocal.time) / 1000.0f);
+    }
+    mpInfo->SetAlpha(alpha);
+
+    mpTime->color = coopLivesOriginalColor;
+    if (lives <= 1 && ((gameLocal.time / 250) & 1) == 0) {
+        mpTime->color.r = 255;
+        mpTime->color.g = 32;
+        mpTime->color.b = 32;
+        mpTime->color.a = 255;
+    }
+
+    if (respawning && respawnMessage) {
+        idSWFTextInstance* respawnText = respawnMessage->GetScriptObject()->GetNestedText("info", "txtMessage");
+        if (respawnText) {
+            if (!coopRespawnTextColorSaved) {
+                coopRespawnOriginalColor = respawnText->color;
+                coopRespawnTextColorSaved = true;
+            }
+            respawnText->color = coopRespawnOriginalColor;
+            if (lives <= 1 && ((gameLocal.time / 250) & 1) == 0) {
+                respawnText->color.r = 255;
+                respawnText->color.g = 32;
+                respawnText->color.b = 32;
+                respawnText->color.a = 255;
+            }
+        }
+    } else if (respawnMessage && coopRespawnTextColorSaved) {
+        idSWFTextInstance* respawnText = respawnMessage->GetScriptObject()->GetNestedText("info", "txtMessage");
+        if (respawnText) respawnText->color = coopRespawnOriginalColor;
+    }
+}
