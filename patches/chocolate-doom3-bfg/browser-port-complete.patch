+static bool ReadBrowserDisplay(int (&surface)[4])
+{
+    EM_ASM({
+        const state = Module['browserDisplayState'];
+        if (!state) return;
+        const sequence = Atomics.load(state, 0);
+        if (sequence & 1) return;
+        const width = Atomics.load(state, 1);
+        const height = Atomics.load(state, 2);
