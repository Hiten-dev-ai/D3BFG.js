+static bool WebGLNeedsRGBAExpansion(const idImageOpts& opts)
+{
+    const bool s3tcDimensionFallback = (opts.format == FMT_DXT1 || opts.format == FMT_DXT5)
+        && ((opts.width & 3) != 0 || (opts.height & 3) != 0);
+    return opts.colorFormat == CFM_GREEN_ALPHA
