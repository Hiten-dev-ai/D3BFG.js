+// browserDisplayState is the shared-memory contract between the UI and the
+// engine worker: [5] means an active multiplayer room, [6] is this peer, and
+// [7] is the room's authorized host peer.
+static bool WebGetLobbyPeers(uint32& localPeerId, uint32& hostPeerId)
+{
+    localPeerId = 0;
+    hostPeerId = 0;
+    return EM_ASM_INT({
+        const state = Module['browserDisplayState'];
+        if (!state || state.length < 8 || !Atomics.load(state, 5)) return 0;
+        const localPeer = Atomics.load(state, 6) >>> 0;
+        const hostPeer = Atomics.load(state, 7) >>> 0;
+        if (!localPeer || !hostPeer) return 0;
+        HEAPU32[$0 >> 2] = localPeer;
+        HEAPU32[$1 >> 2] = hostPeer;
+        return 1;
+    }, &localPeerId, &hostPeerId) != 0;
+}
+
+static void WebSetPeerAddress(netadr_t& address, uint32 peerId, int port)
+{
+    address.type = NA_IP;
+    address.ip[0] = (byte)(peerId & 0xff);
+    address.ip[1] = (byte)((peerId >> 8) & 0xff);
+    address.ip[2] = (byte)((peerId >> 16) & 0xff);
+    address.ip[3] = (byte)((peerId >> 24) & 0xff);
+    address.port = (unsigned short)port;
+}
+
+static uint32 WebGetPeerAddressId(const netadr_t& address)
+{
+    if (address.type != NA_IP) {
+        return 0;
+    }
+    return (uint32)address.ip[0] |
+        ((uint32)address.ip[1] << 8) |
+        ((uint32)address.ip[2] << 16) |
+        ((uint32)address.ip[3] << 24);
+}
+
+static bool WebSetLocalPeerAddress(netadr_t& address)
+{
+    uint32 localPeerId = 0;
+    uint32 hostPeerId = 0;
+    if (!WebGetLobbyPeers(localPeerId, hostPeerId) || localPeerId != hostPeerId) {
+        return false;
+    }
+    WebSetPeerAddress(address, localPeerId, net_port.GetInteger());
+    return true;
+}
