+void idMenuScreen_Shell_WebMultiplayer::SubmitCreate()
+{
+    if (!IsSafeLobbyName(lobbyName)) {
+        localError = "Enter a lobby name using visible ASCII characters.";
+        BuildPage();
+        return;
+    }
+    const idStrList& modes = common->GetModeList();
+    const int count = Min(5, modes.Num());
+    const idList<mpMap_t>& maps = common->GetMapList();
+    if (!coopFlow && (maps.Num() <= 0 || count <= 0)) {
+        localError = "No supported multiplayer maps or modes are available.";
+        BuildPage();
+        return;
+    }
+    lastLobbyName = lobbyName;
+    lastLobbyMode = modeIndex;
+    lastLobbyMap = mapIndex;
+    lastLobbyMaxPlayers = maxPlayers;
+    lastLobbyLives = coopLives;
+    lastLobbyPrivate = isPrivate;
+    if (coopFlow) { pendingCampaign = true; autoStartCoop = true; }
+    const int safeMap = maps.Num() > 0 ? idMath::ClampInt(0, maps.Num() - 1, mapIndex) : 0;
+    const char* kind = coopFlow ? "coop" : "versus";
+    static const char* const protocolModes[] = { "deathmatch", "tourney", "team_deathmatch", "lastman", "ctf" };
+    const char* mode = coopFlow ? "coop" : protocolModes[idMath::ClampInt(0, count - 1, modeIndex)];
+    const int maximum = coopFlow ? 2 : idMath::ClampInt(2, 8, maxPlayers);
+    idStr map = coopFlow ? "mars_city1" : maps[safeMap].mapFile;
+    if (!coopFlow) {
+        map.StripFileExtension();
+        map.StripPath();
+    }
+    BrowserBridge_Action(va("mpCreate|%s|%s|%s|%d|%d|%s|%d|%d", kind, lobbyName.c_str(), mode,
+        maximum, isPrivate ? 1 : 0, map.c_str(), coopLives, friendlyFire ? 1 : 0));
+    localError.Clear();
+}
