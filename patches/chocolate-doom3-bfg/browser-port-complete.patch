+// Browser settings use the game's original SWF controls and command bar.
+#pragma hdrstop
+#include "precompiled.h"
+#include "../Game_local.h"
+#include "MenuScreen_Shell_BrowserBridge.h"
+
+class idMenuDataSource_WebGraphicsSettings : public idMenuDataSource {
+public:
+    enum graphicsField_t {
+        GRAPHICS_FIELD_ANISOTROPY,
+        GRAPHICS_FIELD_TRILINEAR,
+        GRAPHICS_FIELD_RENDERER
+    };
+
+    void LoadData() {
+        originalAnisotropy = r_maxAnisotropicFiltering.GetInteger();
+        originalTrilinear = r_useTrilinearFiltering.GetBool();
+    }
+    void CommitData() { cvarSystem->SetModifiedFlags(CVAR_ARCHIVE); }
+    bool IsDataChanged() const {
+        return originalAnisotropy != r_maxAnisotropicFiltering.GetInteger() ||
+            originalTrilinear != r_useTrilinearFiltering.GetBool();
+    }
+    idSWFScriptVar GetField(const int field) const {
+        if (field == GRAPHICS_FIELD_RENDERER) return "WebGL 2";
+        if (field == GRAPHICS_FIELD_ANISOTROPY) {
+            const int value = r_maxAnisotropicFiltering.GetInteger();
+            return value <= 1 ? "1x" : va("%dx", value);
+        }
+        return r_useTrilinearFiltering.GetBool() ? "Trilinear" : "Bilinear";
+    }
+    void AdjustField(const int field, const int amount) {
+        if (field == GRAPHICS_FIELD_ANISOTROPY) {
+            static const int values[] = { 1, 2, 4, 8, 16 };
+            const int count = sizeof(values) / sizeof(values[0]);
+            int index = 0;
+            for (int i = 0; i < count; ++i) {
+                if (r_maxAnisotropicFiltering.GetInteger() <= values[i]) { index = i; break; }
+                index = i;
+            }
+            index = idMath::ClampInt(0, count - 1, index + amount);
+            r_maxAnisotropicFiltering.SetInteger(values[index]);
+        } else if (field == GRAPHICS_FIELD_TRILINEAR && amount != 0) {
+            r_useTrilinearFiltering.SetBool(!r_useTrilinearFiltering.GetBool());
+        }
+    }
+
+private:
+    int originalAnisotropy;
+    bool originalTrilinear;
+};
+
+static idMenuDataSource_WebGraphicsSettings webGraphicsData;
+
+static idStr BrowserAccountQuote(const idStr& value)
+{
+    idStr escaped = value;
+    escaped.Replace("\\", "\\\\");
+    escaped.Replace("\"", "\\\"");
+    return idStr(va("\"%s\"", escaped.c_str()));
+}
