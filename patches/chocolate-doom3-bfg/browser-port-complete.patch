+void idMenuScreen_Shell_WebMultiplayer::ShowScreen(const mainMenuTransition_t transitionType)
+{
+    multiplayerEditConsumedKeys.Clear();
+    BrowserBridge_Action("mpValidateResume");
+    pageFadePhase = 0;
+    if (BrowserBridge_GetNumber("mpInRoom")) page = PAGE_ROOM;
+    else {
+        page = PAGE_HOME;
+        coopFlow = false;
+        pendingAction = MP_PENDING_NONE;
+        restoreFocus = 0;
+    }
+    editing = EDIT_NONE;
+    localError.Clear();
+    renderedRevision = -1;
+    if (BindSprite(GetSWFObject()->GetRootObject())) BrowserBridge_SubpageTransition(GetSprite(), menuData, "_webMultiplayerPage", page, true);
+    BuildPage();
+    idMenuScreen::ShowScreen(transitionType);
+}
+
+void idMenuScreen_Shell_WebMultiplayer::HideScreen(const mainMenuTransition_t transitionType)
+{
+    multiplayerEditConsumedKeys.Clear();
+    pageFadePhase = 0;
+    if (GetSprite()) GetSprite()->SetAlpha(1.0f);
+    if (GetSprite()) {
+        GetSprite()->GetScriptObject()->Set("_webFadeStart", Sys_Milliseconds());
+        GetSprite()->GetScriptObject()->Set("_webFadeOut", true);
+    }
+    // The authored settings sprite is shared with other native pages.
+    if (options && options->GetSprite()) {
+        idSWFScriptVar original = options->GetSprite()->GetScriptObject()->Get("_webOptionsX");
+        if (!original.IsUndefined()) options->GetSprite()->SetXPos(original.ToFloat());
+    }
+    editing = EDIT_NONE;
+    idMenuScreen::HideScreen(transitionType);
+}
+
+void idMenuScreen_Shell_WebMultiplayer::Back()
+{
+    if (!BrowserBridge_GetNumber("mpInRoom")) BrowserBridge_Action("mpCancelPending");
+    // Cancel any deferred create/join action when the user explicitly backs out.
+    pendingAction = MP_PENDING_NONE;
+    if (editing != EDIT_NONE) {
+        editing = EDIT_NONE;
+        UpdateEditLabel();
+        return;
+    }
+    if (page == PAGE_ROOM) {
+        // Leaving a waiting lobby removes it for everyone, so ask first instead
+        // of dropping straight back into whatever screen the session uses next.
+        ShowLeaveLobbyConfirm();
+        return;
+    }
+    if (page == PAGE_CREATE || page == PAGE_JOIN) {
+        const bool wasJoin = page == PAGE_JOIN;
+        restoreFocus = coopFlow ? (wasJoin ? 1 : 0) : (wasJoin ? 1 : 0);
+        page = coopFlow ? PAGE_COOP : PAGE_HOME;
+    } else if (page == PAGE_COOP) {
+        restoreFocus = 2;
+        page = PAGE_HOME;
+    } else if (menuData) {
+        BrowserBridge_Action("mpDisconnect");
+        menuData->SetNextScreen(SHELL_AREA_ROOT, MENU_TRANSITION_SIMPLE);
+        return;
+    }
+    BuildPage();
+}
+
+static bool StartBrowserCoopSaveLoad(const char* slotName)
+{
+    if (slotName == NULL || !*slotName || strlen(slotName) > 128) return false;
+    for (const char* c = slotName; *c; ++c) {
+        if (!((*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') ||
+            (*c >= '0' && *c <= '9') || *c == '_' || *c == '-')) return false;
+    }
+    BrowserBridge_Action("mpOpenCoopSavePicker");
+    if (!BrowserBridge_GetNumber("mpCoopSavePicker")) return false;
+    cmdSystem->AppendCommandText(va("webCoopLoad %s\n", slotName));
+    BrowserBridge_Action("mpCloseCoopSavePicker");
+    return true;
+}
+
+static bool StartNewestBrowserCoopSaveLoad()
+{
+    if (session->GetSaveGameManager().IsWorking()) return false;
+    saveGameDetailsList_t saves = session->GetSaveGameManager().GetEnumeratedSavegames();
+    saves.Sort(idSort_SavesByDate());
+    for (int i = 0; i < saves.Num(); ++i) {
+        const idSaveGameDetails& save = saves[i];
+        if (save.damaged || save.GetSaveVersion() > BUILD_NUMBER) continue;
+        if (StartBrowserCoopSaveLoad(save.slotName.c_str())) return true;
+    }
+    return false;
+}
