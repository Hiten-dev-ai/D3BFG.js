+/*
+================
+idPlayer::IsCollidingWithPlayer
+
+Tests actual player clip contents at the current bounds. Used only to decide
+whether a co-op spawn overlap still needs its temporary phase-walk mask.
+================
+*/
+bool idPlayer::IsCollidingWithPlayer()
+{
+    idPhysics* physics = GetPhysics();
+    if (physics == NULL || physics->GetNumClipModels() == 0) {
+        return false;
+    }
+
+    idClipModel* clipModels[MAX_GENTITIES];
+    const int numClipModels = gameLocal.clip.ClipModelsTouchingBounds(
+        physics->GetAbsBounds(), physics->GetClipMask(), clipModels, MAX_GENTITIES);
+
+    for (int i = 0; i < numClipModels; ++i) {
+        idClipModel* clipModel = clipModels[i];
+        if (clipModel->IsRenderModel()) {
+            continue;
+        }
+
+        idEntity* other = clipModel->GetEntity();
+        if (other == NULL || other == this || !physics->ClipContents(clipModel)) {
+            continue;
+        }
+
+        if (other->IsType(idPlayer::Type)) {
+            return true;
+        }
+    }
+
+    return false;
+}
