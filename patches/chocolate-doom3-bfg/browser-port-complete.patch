+/*
+================
+idAI::WriteToSnapshot
+
+The stock multiplayer snapshot path does not serialize idAI. Campaign co-op
+uses the server's idPhysics_Monster state for client interpolation and shares
+the small set of actor state needed to recognize death and orientation.
+================
+*/
+void idAI::WriteToSnapshot(idBitMsg& msg) const
+{
+    if (gameLocal.gameType != GAME_COOP) {
+        return idEntity::WriteToSnapshot(msg);
+    }
+
+    physicsObj.WriteToSnapshot(msg);
+    msg.WriteFloat(current_yaw);
+    msg.WriteShort(health);
+    msg.WriteBits(AI_DEAD, 1);
+    msg.WriteBits(AI_ONGROUND, 1);
+    msg.WriteShort(currentTorsoAnim);
+    msg.WriteShort(currentLegsAnim);
+}
+
+/*
+================
+idAI::ReadFromSnapshot
+================
+*/
+void idAI::ReadFromSnapshot(const idBitMsg& msg)
+{
+    if (gameLocal.gameType != GAME_COOP) {
+        return idEntity::ReadFromSnapshot(msg);
+    }
+
+    const bool wasDead = AI_DEAD;
+
+    physicsObj.ReadFromSnapshot(msg);
+    current_yaw = msg.ReadFloat();
+    ideal_yaw = current_yaw;
+    health = msg.ReadShort();
+    AI_DEAD = msg.ReadBits(1) != 0;
+    AI_ONGROUND = msg.ReadBits(1) != 0;
+    const int torsoAnim = msg.ReadShort();
+    const int legsAnim = msg.ReadShort();
+
+    if (torsoAnim != currentTorsoAnim) {
+        if (torsoAnim > 0) {
+            animator.CycleAnim(ANIMCHANNEL_TORSO, torsoAnim, gameLocal.time, 2);
+        } else {
+            animator.Clear(ANIMCHANNEL_TORSO, gameLocal.time, 2);
+        }
+    }
+    if (legsAnim != currentLegsAnim) {
+        if (legsAnim > 0) {
+            animator.CycleAnim(ANIMCHANNEL_LEGS, legsAnim, gameLocal.time, 2);
+        } else {
+            animator.Clear(ANIMCHANNEL_LEGS, gameLocal.time, 2);
+        }
+    }
+    currentTorsoAnim = torsoAnim;
+    currentLegsAnim = legsAnim;
+
+    physicsObj.SetAxis(idAngles(0.0f, current_yaw, 0.0f).ToMat3());
+
+    // Client-side damage simulation is intentionally disabled; transition the
+    // campaign actor into its authored death animation when the host reports
+    // the death. The host still owns all damage, target activation and drops.
+    if (!wasDead && AI_DEAD) {
+        SetAnimState(ANIMCHANNEL_LEGS, "Legs_Death", 4);
+        SetAnimState(ANIMCHANNEL_TORSO, "Torso_Death", 4);
+        SetWaitState("");
+    }
+    UpdateVisuals();
+}
+
+/*
+================
+idAI::ClientThink
+
+In campaign co-op the host runs AI scripts and gameplay decisions. The guest
+only interpolates authoritative physics and advances the animation IDs received
+in snapshots. Non-co-op keeps the inherited animated-entity client path.
+================
+*/
+void idAI::ClientThink(const int curTime, const float fraction, const bool predict)
+{
+    if (gameLocal.mpGame.IsGametypeCoopBased()) {
+        // The inherited path evaluates monster/AF physics before interpolation.
+        // A guest must not independently simulate host-owned campaign actors.
+        InterpolatePhysicsOnly(fraction);
+        UpdateAnimation();
+        Present();
+        return;
+    }
+    idAnimatedEntity::ClientThink(curTime, fraction, predict);
+}
