+void idMenuScreen_Shell_WebMultiplayer::AddRow(const char* label, int command, bool disabled)
+{
+    idMenuWidget_ControlButton* control = new (TAG_SWF) idMenuWidget_ControlButton();
+    control->Initialize(menuData);
+    control->SetOptionType(OPTION_BUTTON_TEXT);
+    control->SetLabel(label);
+    control->SetDisabled(disabled);
+    control->SetupEvents(DEFAULT_REPEAT_TIME, options->GetChildren().Num());
+    if (!disabled) control->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_COMMAND, command);
+    options->AddChild(control);
+}
+
+void idMenuScreen_Shell_WebMultiplayer::AddCycleRow(const char* label, int command, bool disabled)
+{
+    idMenuWidget_ControlButton* control = new (TAG_SWF) idMenuWidget_ControlButton();
+    control->Initialize(menuData);
+    control->SetOptionType(OPTION_SLIDER_TEXT);
+    control->SetLabel(label);
+    control->SetDataSource(this, command);
+    control->SetDisabled(disabled);
+    control->SetupEvents(DEFAULT_REPEAT_TIME, options->GetChildren().Num());
+    control->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_COMMAND, command);
+    options->AddChild(control);
+}
