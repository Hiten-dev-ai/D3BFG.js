+static bool IsSafeLobbyName(const idStr& value) {
+    if (value.Length() < 1 || value.Length() > 48) return false;
+    for (int i = 0; i < value.Length(); ++i) {
+        const unsigned char ch = value[i];
+        if (ch < 32 || ch > 126 || ch == '|') return false;
+    }
+    return true;
+}
+
+static bool IsSafePrivateCode(const idStr& value) {
+    if (value.Length() < 1 || value.Length() > 64) return false;
+    for (int i = 0; i < value.Length(); ++i) {
+        const unsigned char ch = value[i];
+        if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+            (ch >= '0' && ch <= '9') || ch == '-' || ch == '_')) return false;
+    }
+    return true;
+}
+
+static bool ContainsCharacter(const char* value, char character) {
+    if (!value) return false;
+    for (int i = 0; value[i] != '\0'; ++i) {
+        if (value[i] == character) return true;
+    }
+    return false;
+}
