+        fileSystem->CloseFile(binkFile);
+        binkFile = NULL;
+        return false;
+    }
+
+    return true;
+}
+
+void idCinematicLocal::CloseBinkDecFile(bool releaseResource)
+{
+    if (binkDecoder != NULL) {
+        delete binkDecoder;
+        binkDecoder = NULL;
+    }
+    if (binkFile != NULL) {
+        fileSystem->CloseFile(binkFile);
+        binkFile = NULL;
+    }
+
+    if (releaseResource && binkResourceStaged) {
+        WebReleaseBinkResource(binkFileName.c_str());
+        binkResourceStaged = false;
+        binkFileName.Clear();
+    }
