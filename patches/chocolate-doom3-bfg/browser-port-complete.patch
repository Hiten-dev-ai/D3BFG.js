+void idMenuScreen_Shell_WebSettings::Update()
+{
+    BrowserBridge_UpdateTransition(GetSprite());
+    if (page == PAGE_BROWSER && browserRowsDirty) {
+        browserRowsDirty = false;
+        if (menuData) menuData->ClearWidgetActionRepeater();
+        RebuildBrowserRows();
+    }
+    if (page == PAGE_BROWSER && profilePage == 0 && profileControl != NULL) {
+        profileName = BrowserBridge_GetText("profileName", "Marine");
+        profileControl->SetLabel(va("Manage profile: %s", profileName.c_str()));
+        cvarSystem->SetCVarString("ui_name", profileName.c_str());
+    }
+    if (page == PAGE_BROWSER && profileStatusControl) {
+        const idStr status = BrowserBridge_GetText("accountStatus");
+        if (profileStatus != status) {
+            profileStatus = status;
+            profileStatusControl->SetLabel(status.Length() ? status.c_str() : "Select a field to edit; Enter finishes editing.");
+        }
+    }
+    idSWFScriptObject& root = GetSWFObject()->GetRootObject();
+    if (BindSprite(root)) {
+        idSWFTextInstance* heading = GetSprite()->GetScriptObject()->GetNestedText("info", "txtHeading");
+        if (heading) {
+            heading->SetText(page == PAGE_VIDEO ? "Video" : page == PAGE_AUDIO ? "Audio" : page == PAGE_EXTRAS ? "Extras" :
+                profilePage == 1 ? "Manage profile" : profilePage == 2 ? "Change password" : profilePage == 3 ? "Delete account" : "Browser");
+            heading->SetStrokeInfo(true, 0.75f, 1.75f);
+        }
+        idSWFSpriteInstance* gradient = GetSprite()->GetScriptObject()->GetNestedSprite("info", "gradient");
+        if (gradient && heading) gradient->SetXPos(heading->GetTextLength());
+    }
+    if (page == PAGE_AUDIO && resolutionControl) {
+        resolutionControl->SetDisabled(!BrowserBridge_GetNumber("audioOutputSupported"));
+        resolutionControl->SetLabel("Output device");
+    }
+    if (btnBack) {
+        btnBack->SetLabel(page == PAGE_BROWSER && profilePage != 0
+            ? (profilePage == 1 ? "BROWSER" : "PROFILE") : "SETTINGS");
+    }
+    if (menuData && menuData->GetCmdBar()) {
+        idMenuWidget_CommandBar* bar = menuData->GetCmdBar();
+        bar->ClearAllButtons();
+        bar->GetButton(idMenuWidget_CommandBar::BUTTON_JOY2)->label = "#str_00395";
+        bar->GetButton(idMenuWidget_CommandBar::BUTTON_JOY2)->action.Set(WIDGET_ACTION_GO_BACK);
+        bar->GetButton(idMenuWidget_CommandBar::BUTTON_JOY1)->action.Set(WIDGET_ACTION_PRESS_FOCUSED);
+    }
+    if (btnBack) btnBack->BindSprite(root);
+    idMenuScreen::Update();
+}
+void idMenuScreen_Shell_WebSettings::ShowScreen(const mainMenuTransition_t type)
+{
+    editingProfile = false;
+    profilePage = 0;
+    profileEditing = -1;
+    profileReleaseKey = 0;
+    if (page == PAGE_BROWSER) { BrowserBridge_Action("accountReset"); BuildBrowserRows(); }
+    if (page == PAGE_BROWSER && BindSprite(GetSWFObject()->GetRootObject())) BrowserBridge_SubpageTransition(GetSprite(), menuData, "_webProfilePage", profilePage, true);
+    engineData.LoadData(); browserData.LoadData(); audioData.LoadData(); webGraphicsData.LoadData();
+    idMenuScreen::ShowScreen(type);
+}
+void idMenuScreen_Shell_WebSettings::HideScreen(const mainMenuTransition_t type)
+{
+    for (int i = 2; i < 5; ++i) profileFields[i].Clear();
+    profileEditOriginal.Clear();
+    profileEditing = -1;
+    if (engineData.IsDataChanged()) engineData.CommitData();
+    if (audioData.IsDataChanged()) audioData.CommitData();
+    if (page == PAGE_VIDEO && webGraphicsData.IsDataChanged()) webGraphicsData.CommitData();
+    if ((page == PAGE_BROWSER || page == PAGE_EXTRAS) && browserData.IsDataChanged()) BrowserSettingsConfirm("restart");
+    else if (page == PAGE_VIDEO && engineData.IsRestartRequired()) BrowserSettingsConfirm("restart");
+    idMenuScreen::HideScreen(type);
+}
+bool idMenuScreen_Shell_WebSettings::HandleAction(idWidgetAction& action, const idWidgetEvent& event, idMenuWidget* widget, bool forceHandled)
+{
+    typedef idMenuScreen_Shell_SystemOptions::idMenuDataSource_SystemSettings E;
+    typedef idMenuDataSource_BrowserSettings B;
+    const int area = page == PAGE_VIDEO ? SHELL_AREA_VIDEO : page == PAGE_AUDIO ? SHELL_AREA_AUDIO : page == PAGE_EXTRAS ? SHELL_AREA_EXTRAS : SHELL_AREA_BROWSER_SETTINGS;
+    if (!menuData || menuData->ActiveScreen() != area) return false;
+    if (action.GetType() == WIDGET_ACTION_GO_BACK) {
+        if (page == PAGE_BROWSER && profilePage != 0) {
+            profilePage = profilePage == 1 ? 0 : 1;
+            profileEditing = -1;
+            for (int i = 2; i < 5; ++i) profileFields[i].Clear();
+            profileEditOriginal.Clear();
+            BuildBrowserRows();
+            return true;
+        }
+        menuData->SetNextScreen(SHELL_AREA_SETTINGS, MENU_TRANSITION_SIMPLE); return true;
+    }
+    const idSWFParmList& parms = action.GetParms();
+    if (action.GetType() == WIDGET_ACTION_COMMAND && parms.Num()) {
+        const int command = parms[0].ToInteger();
+        if (page == PAGE_BROWSER && profilePage != 0) {
+            if (BrowserBridge_GetNumber("accountBusy")) return true;
+            if (command >= 700 && command < 705) {
+                profileEditing = command - 700;
+                profileEditOriginal = profileFields[profileEditing];
+                UpdateProfileField(profileEditing);
+            } else if (command == 710) {
+                BrowserAccountConfirm(va("accountSave|[%s,%s]", BrowserAccountQuote(profileFields[0]).c_str(), BrowserAccountQuote(profileFields[1]).c_str()),
+                    va("Change your profile to %s and %s?", profileFields[0].c_str(), profileFields[1].c_str()), "Save profile");
+            } else if (command == 711 || command == 712) {
+                profilePage = command == 711 ? 2 : 3;
+                profileEditing = -1;
+                BrowserBridge_Action("accountReset");
+                for (int i = 2; i < 5; ++i) profileFields[i].Clear();
+                BuildBrowserRows();
+            } else if (command == 713) {
+                BrowserAccountConfirm("accountLogout", "Log out of this account and return to the login screen? Pending saves will sync first.", "Log out");
+            } else if (command == 714 || command == 715) {
+                const idStr payload = command == 714
+                    ? idStr(va("accountPassword|[%s,%s,%s]", BrowserAccountQuote(profileFields[2]).c_str(), BrowserAccountQuote(profileFields[3]).c_str(), BrowserAccountQuote(profileFields[4]).c_str()))
+                    : idStr(va("accountDelete|[%s]", BrowserAccountQuote(profileFields[2]).c_str()));
+                BrowserAccountConfirm(payload, command == 714 ? "Change this account's password? Other devices will be signed out."
+                    : "Permanently delete this account and ALL its saved games? This cannot be undone.", command == 714 ? "Change password" : "Delete account");
+                for (int i = 2; i < 5; ++i) { profileFields[i].Clear(); UpdateProfileField(i); }
+            }
+            options->Update();
+            return true;
+        }
+        if (command == 300) BrowserSettingsConfirm("clearData");
+        else if (command == 306) browserData.AdjustField(B::BROWSER_FIELD_SKIP_INTRO, 1);
+        else if (command == 100) browserData.AdjustField(B::BROWSER_FIELD_AUDIO_OUTPUT, 1);
+        else if (command == 302) BrowserSettingsConfirm("restart");
+        else if (command == 106 || command == 303) {
+            profileFields[0] = BrowserBridge_GetText("profileName", "Marine");
+            profileFields[1] = BrowserBridge_GetText("profileEmail");
+            profilePage = command == 106 ? 1 : 3;
+            profileEditing = -1;
+            for (int i = 2; i < 5; ++i) profileFields[i].Clear();
+            BrowserBridge_Action("accountReset");
+            BuildBrowserRows();
+        }
+        else if (command == 410 || command == 411) return true;
+        else if (command == E::SYSTEM_FIELD_WEB_FPS_COUNTER) engineData.AdjustField(command, 1);
+        else if (command >= 400) webGraphicsData.AdjustField(command - 400, 1);
+        else if (command >= 200) audioData.AdjustField(command - 200, 1);
+        else if (command >= 100) browserData.AdjustField(command - 100, 1);
+        else engineData.AdjustField(command, 1);
+        options->Update(); return true;
+    }
+    return idMenuWidget::HandleAction(action, event, widget, forceHandled);
+}
+
+bool idMenuScreen_Shell_WebSettings::HandleBrowserInput(const sysEvent_t* event)
+{
+    if (!event || !menuData || menuData->ActiveScreen() != SHELL_AREA_BROWSER_SETTINGS) return false;
+    if (event->evType == SE_KEY && profileReleaseKey == event->evValue) {
+        if (!event->evValue2) profileReleaseKey = 0;
+        return true;
+    }
+    if (profileEditing < 0 || profileEditing >= 5) return false;
+    const int field = profileEditing;
+    if (event->evType == SE_KEY) {
+        if (event->evValue2) {
+            if (event->evValue == K_ESCAPE || event->evValue == K_ENTER || event->evValue == K_KP_ENTER || event->evValue == K_TAB) {
+                if (event->evValue == K_ESCAPE) profileFields[field] = profileEditOriginal;
+                profileEditing = -1;
+                profileEditOriginal.Clear();
+                profileReleaseKey = event->evValue;
+            } else if (event->evValue == K_BACKSPACE && profileFields[field].Length()) {
+                int length = profileFields[field].Length() - 1;
+                while (length > 0 && (static_cast<unsigned char>(profileFields[field][length]) & 0xC0) == 0x80) --length;
+                profileFields[field].CapLength(length);
+            }
+            UpdateProfileField(field);
+            options->Update();
+        }
+        return true;
+    }
+    if (event->evType == SE_CHAR) {
+        const int ch = event->evValue;
+        if (ch < 32 || ch == 127 || ch > 0x10FFFF || (ch >= 0xD800 && ch <= 0xDFFF)) return true;
+        const int limit = field == 0 ? 48 : field == 1 ? 254 : 256;
+        idStr next = profileFields[field];
+        next.AppendUTF8Char(ch);
+        if (next.Length() <= limit) profileFields[field] = next;
+        UpdateProfileField(field);
+        options->Update();
+        return true;
+    }
+    return false;
+}
