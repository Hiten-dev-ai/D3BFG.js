+// Draw an accessory in the same authored coordinate space as its native menu.
+// Raw virtual-screen coordinates do not follow the SWF's aspect fit or rollOn.
+void idSWF::DrawMaterialOnSprite(idSWFSpriteInstance* anchor, float x, float y, float w, float h, const idMaterial* material)
+{
+    if (!anchor || !material) return;
+    swfMatrix_t local;
+    float alpha = 1.0f;
+    for (idSWFSpriteInstance* node = anchor; node; node = node->parent) {
+        if (!node->IsVisible()) return;
+        if (node->parent) {
+            const swfDisplayEntry_t* entry = node->parent->FindDisplayEntry(node->depth);
+            if (!entry) return;
+            local = local.Multiply(entry->matrix);
+            alpha *= entry->cxf.mul.w;
+        }
+    }
+    const float pixelAspect = renderSystem->GetPixelAspect();
+    const float sysWidth = renderSystem->GetWidth() * (pixelAspect > 1.0f ? pixelAspect : 1.0f);
+    const float sysHeight = renderSystem->GetHeight() / (pixelAspect < 1.0f ? pixelAspect : 1.0f);
+    const float scale = swfScale * sysHeight / frameHeight;
+    swfMatrix_t fit;
+    fit.xx = fit.yy = scale;
+    fit.tx = 0.5f * (sysWidth - frameWidth * scale);
+    fit.ty = 0.5f * (sysHeight - frameHeight * scale);
+    local = local.Multiply(fit);
+    scaleToVirtual.Set(float(renderSystem->GetVirtualWidth()) / sysWidth, float(renderSystem->GetVirtualHeight()) / sysHeight);
+    const idVec2 tl = local.Transform(idVec2(x, y));
+    const idVec2 tr = local.Transform(idVec2(x + w, y));
+    const idVec2 br = local.Transform(idVec2(x + w, y + h));
+    const idVec2 bl = local.Transform(idVec2(x, y + h));
+    renderSystem->SetColor(idVec4(1, 1, 1, alpha));
+    DrawStretchPic(idVec4(tl.x, tl.y, 0, 0), idVec4(tr.x, tr.y, 1, 0),
+        idVec4(br.x, br.y, 1, 1), idVec4(bl.x, bl.y, 0, 1), material);
+    renderSystem->SetColor(colorWhite);
+}
+
+// Render a native animation without presenting its surrounding menu or cursor.
+void idSWF::RenderNamedSprite(idRenderSystem* gui, const char* name, float x, float y, float scale, int time)
+{
+    idSWFSpriteInstance* sprite = GetRootObject().GetNestedSprite(name);
+    if (!IsLoaded() || !sprite) return;
+    const int now = Sys_Milliseconds();
+    const float fps = frameRate / 256.0f;
+    const int frames = lastRenderTime == 0 ? 1 : idMath::ClampInt(0, 10, idMath::Ftoi((now - lastRenderTime) * fps / 1000.0f));
+    if (lastRenderTime == 0) lastRenderTime = now;
+    else if (frames > 0) lastRenderTime += idMath::Ftoi(frames * 1000.0f / fps);
+    sprite->SetVisible(true);
+    for (int i = 0; i < frames; ++i) { sprite->Run(); sprite->RunActions(); }
+    scaleToVirtual.Set(1.0f, 1.0f);
+    swfRenderState_t state;
+    state.matrix.xx = state.matrix.yy = scale;
+    state.matrix.tx = x;
+    state.matrix.ty = y;
+    RenderSprite(gui, sprite, state, time);
+    gui->SetGLState(0);
+}
