+void idMenuScreen_Shell_WebSettings::Initialize(idMenuHandler* data)
+{
+    idMenuScreen::Initialize(data);
+    menuGUI = data ? data->GetGUI() : NULL;
+    SetSpritePath("menuSystemOptions");
+    options = new (TAG_SWF) idMenuWidget_DynamicList();
+    options->SetNumVisibleOptions(8);
+    options->SetSpritePath(GetSpritePath(), "info", "options");
+    options->SetWrappingAllowed(true);
+    options->SetControlList(true);
+    options->Initialize(data);
+    AddChild(options);
+    auto row = [&](const char* label, idMenuDataSource* source, int field, int command, bool bar = false, int repeat = DEFAULT_REPEAT_TIME, bool buttonText = false) {
+        idMenuWidget_ControlButton* control = new (TAG_SWF) idMenuWidget_ControlButton();
+        control->SetOptionType(!source || buttonText ? OPTION_BUTTON_TEXT : bar ? OPTION_SLIDER_BAR : OPTION_SLIDER_TEXT);
+        control->SetLabel(label);
+        if (source) control->SetDataSource(source, field);
+        if (source) control->SetupEvents(repeat, options->GetChildren().Num());
+        control->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_COMMAND, command);
+        options->AddChild(control);
+        return control;
+    };
+    typedef idMenuScreen_Shell_SystemOptions::idMenuDataSource_SystemSettings E;
+    typedef idMenuDataSource_BrowserSettings B;
+    if (page == PAGE_VIDEO) {
+        idMenuWidget_ControlButton* rendererControl = row("Renderer", &webGraphicsData, idMenuDataSource_WebGraphicsSettings::GRAPHICS_FIELD_RENDERER, 402);
+        rendererControl->SetDescription("WebGL 2 is active. WebGPU is unavailable in this build.");
+        rendererControl->SetDisabled(true);
+        row("Anti-aliasing", &engineData, E::SYSTEM_FIELD_ANTIALIASING, E::SYSTEM_FIELD_ANTIALIASING);
+        row("Motion blur", &engineData, E::SYSTEM_FIELD_MOTIONBLUR, E::SYSTEM_FIELD_MOTIONBLUR);
+        row("Detail distance", &engineData, E::SYSTEM_FIELD_LODBIAS, E::SYSTEM_FIELD_LODBIAS, true);
+        row("Brightness", &engineData, E::SYSTEM_FIELD_BRIGHTNESS, E::SYSTEM_FIELD_BRIGHTNESS, true);
+        row("Texture filtering", &webGraphicsData, idMenuDataSource_WebGraphicsSettings::GRAPHICS_FIELD_TRILINEAR, 400 + idMenuDataSource_WebGraphicsSettings::GRAPHICS_FIELD_TRILINEAR);
+        row("Anisotropic filtering", &webGraphicsData, idMenuDataSource_WebGraphicsSettings::GRAPHICS_FIELD_ANISOTROPY, 400 + idMenuDataSource_WebGraphicsSettings::GRAPHICS_FIELD_ANISOTROPY);
+    } else if (page == PAGE_AUDIO) {
+        row("Master volume", &engineData, E::SYSTEM_FIELD_VOLUME, E::SYSTEM_FIELD_VOLUME, true, 2);
+        row("Music volume", &audioData, idMenuDataSource_AudioSettings::AUDIO_FIELD_MUSIC_VOLUME, 200, true);
+        row("Game and dialogue", &audioData, idMenuDataSource_AudioSettings::AUDIO_FIELD_GAME_VOLUME, 201, true);
+        resolutionControl = row("Output device", &browserData, B::BROWSER_FIELD_AUDIO_OUTPUT, 100);
+        row("Pause audio when unfocused", &audioData, idMenuDataSource_AudioSettings::AUDIO_FIELD_PAUSE_UNFOCUSED, 202)
+            ->SetDescription("Pause sound while this browser window or tab is not focused. Enabled by default; applies immediately.");
+    } else if (page == PAGE_BROWSER) {
+        BuildBrowserRows();
+    } else {
+        row("FPS Counter", &engineData, E::SYSTEM_FIELD_WEB_FPS_COUNTER, E::SYSTEM_FIELD_WEB_FPS_COUNTER);
+        row("Cinematic skip mode", &browserData, B::BROWSER_FIELD_SKIP_INTRO, 306)
+            ->SetDescription("When you skip a scene: Skip hides accelerated frames; Fast forward shows them. Campaign intros play normally.");
+        row("Developer levels", &browserData, B::BROWSER_FIELD_DEVELOPER_LEVELS, 104);
+        row("Enable console", &browserData, B::BROWSER_FIELD_ENABLE_CONSOLE, 103)->SetDescription("Allow the tilde console. Off by default; restart to apply.");
+    }
+    options->AddEventAction(WIDGET_EVENT_SCROLL_DOWN).Set(new (TAG_SWF) idWidgetActionHandler(options, WIDGET_ACTION_EVENT_SCROLL_DOWN_START_REPEATER, WIDGET_EVENT_SCROLL_DOWN));
+    options->AddEventAction(WIDGET_EVENT_SCROLL_UP).Set(new (TAG_SWF) idWidgetActionHandler(options, WIDGET_ACTION_EVENT_SCROLL_UP_START_REPEATER, WIDGET_EVENT_SCROLL_UP));
+    options->AddEventAction(WIDGET_EVENT_SCROLL_DOWN_RELEASE).Set(new (TAG_SWF) idWidgetActionHandler(options, WIDGET_ACTION_EVENT_STOP_REPEATER, WIDGET_EVENT_SCROLL_DOWN_RELEASE));
+    options->AddEventAction(WIDGET_EVENT_SCROLL_UP_RELEASE).Set(new (TAG_SWF) idWidgetActionHandler(options, WIDGET_ACTION_EVENT_STOP_REPEATER, WIDGET_EVENT_SCROLL_UP_RELEASE));
+    // The authored back plate names its destination instead of showing the
+    // sprite's generic "BACK OPTION" placeholder, like the original settings
+    // submenus do.
+    btnBack = new (TAG_SWF) idMenuWidget_Button();
+    btnBack->Initialize(data);
+    btnBack->SetLabel("SETTINGS");
+    btnBack->SetSpritePath(GetSpritePath(), "info", "btnBack");
+    btnBack->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_GO_BACK);
+    AddChild(btnBack);
+}
