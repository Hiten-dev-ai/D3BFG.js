+void idMenuScreen_Shell_WebMultiplayer::RebuildPage()
+{
+    if (!options) return;
+    const int oldView = options->GetViewIndex();
+    const int oldOffset = options->GetViewOffset();
+    options->RemoveAllChildren();
+    nameRow = NULL;
+    codeRow = NULL;
+    options->SetFocusIndex(0, true);
+    options->SetViewIndex(0);
+    options->SetViewOffset(0);
+    // Update every authored slot so the native list hides unused placeholder rows.
+    options->SetNumVisibleOptions(WEB_MULTIPLAYER_VISIBLE_ROWS);
+    const int status = BrowserBridge_GetNumber("mpStatus");
+    const int peerId = BrowserBridge_GetNumber("mpPeerId");
+    const int hostPeerId = BrowserBridge_GetNumber("mpHostPeerId");
+    const bool inRoom = BrowserBridge_GetNumber("mpInRoom") != 0;
+    const idStr error = localError.Length() ? localError : BrowserBridge_GetText("mpErrorMessage");
+
+    if (inRoom) page = PAGE_ROOM;
+    switch (page) {
+    case PAGE_HOME:
+        SetHeading("Multiplayer");
+        // A dropped match is the first thing the player wants back; offer it
+        // before anything that starts a new lobby.
+        if (BrowserBridge_GetNumber("mpCanReconnect")) {
+            const idStr game = BrowserBridge_GetText("mpReconnectName", "");
+            AddRow(game.Length() ? va("Reconnect to %s", game.c_str()) : "Reconnect to game", MP_CMD_RECONNECT);
+        }
+        AddRow("Create Lobby", MP_CMD_CREATE);
+        AddRow("Join Lobby", MP_CMD_JOIN);
+        AddRow("Co-Op", MP_CMD_COOP);
+        if (BrowserBridge_GetNumber("offline"))
+            AddRow("Offline - connect to the internet to play online", MP_CMD_BACK, true);
+        break;
+    case PAGE_COOP:
+        SetHeading("Co-op");
+        AddRow("Create Game", MP_CMD_COOP_CREATE);
+        AddRow("Join Game", MP_CMD_COOP_JOIN);
+        if (error.Length()) AddRow(va("Status: %s", error.c_str()), MP_CMD_BACK, true);
+        AddRow("Back", MP_CMD_BACK);
+        break;
+    case PAGE_CREATE: {
+        SetHeading(coopFlow ? "Create Game" : "Create Lobby");
+        nameRow = new (TAG_SWF) idMenuWidget_ControlButton();
+        nameRow->Initialize(menuData);
+        nameRow->SetOptionType(OPTION_BUTTON_TEXT);
+        nameRow->SetLabel(va("Lobby name: %s%s", lobbyName.c_str(), editing == EDIT_NAME ? "_" : ""));
+        nameRow->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_COMMAND, MP_CMD_NAME);
+        options->AddChild(nameRow);
+        if (!coopFlow) {
+            const idStrList& modes = common->GetModeDisplayList();
+            const int count = Min(5, modes.Num());
+            if (count > 0) modeIndex = idMath::ClampInt(0, count - 1, modeIndex);
+            const idStrList& modeKeys = common->GetModeList();
+            const char* modeName = count > 0 ? idLocalization::GetString(modes[modeIndex]) : "Deathmatch";
+            AddCycleRow("Mode", MP_CMD_MODE, count <= 1 || modeKeys.Num() <= modeIndex);
+        }
+        const idList<mpMap_t>& maps = common->GetMapList();
+        if (!coopFlow && maps.Num() > 0) {
+            mapIndex = idMath::ClampInt(0, maps.Num() - 1, mapIndex);
+            if (!coopFlow && !(maps[mapIndex].supportedModes & BIT(modeIndex))) CycleMap(1);
+            const char* mapName = idLocalization::GetString(maps[mapIndex].mapName);
+            AddCycleRow("Map", MP_CMD_MAP, maps.Num() <= 1);
+        } else if (!coopFlow) {
+            AddRow("Map: unavailable", MP_CMD_MAP, true);
+        }
+        if (!coopFlow) AddCycleRow("Max players", MP_CMD_PLAYERS);
+        else {
+            AddCycleRow("Lives per player", MP_CMD_LIVES);
+            AddCycleRow("Friendly Fire", MP_CMD_FRIENDLY_FIRE);
+        }
+        AddCycleRow("Privacy", MP_CMD_PRIVACY);
+        AddRow(coopFlow ? "Create Game" : "Create Lobby", MP_CMD_CREATE_SUBMIT, !IsSafeLobbyName(lobbyName));
+        if (error.Length()) AddRow(va("Status: %s", error.c_str()), MP_CMD_BACK, true);
+        AddRow("Back", MP_CMD_BACK);
+        break;
+    }
+    case PAGE_JOIN: {
+        SetHeading(joinPageKind == 1 ? "Join Game" : "Join Lobby");
+        const int count = idMath::ClampInt(0, 128, BrowserBridge_GetNumber("mpLobbyCount"));
+        for (int i = 0; i < count; ++i) {
+            const idStr name = BrowserBridge_GetText(va("mpLobbyName%d", i), "Lobby");
+            const idStr occupancy = BrowserBridge_GetText(va("mpLobbyOccupancy%d", i), "");
+            const idStr lobbyId = BrowserBridge_GetText(va("mpLobbyId%d", i), "");
+            // Keep full rooms visible and selectable; the bridge reports the
+            // native full-lobby dialog when the server rejects the join.
+            AddRow(va("%s  %s", name.c_str(), occupancy.c_str()), MP_CMD_LOBBY_BASE + i,
+                lobbyId.Length() == 0);
+        }
+        if (count == 0) AddRow("No public rooms found", MP_CMD_REFRESH, true);
+        AddRow("Refresh rooms", MP_CMD_REFRESH);
+        codeRow = new (TAG_SWF) idMenuWidget_ControlButton();
+        codeRow->Initialize(menuData);
+        codeRow->SetOptionType(OPTION_BUTTON_TEXT);
+        codeRow->SetLabel(va("Enter private code: %s%s", privateCode.c_str(), editing == EDIT_CODE ? "_" : ""));
+        codeRow->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_COMMAND, MP_CMD_CODE);
+        options->AddChild(codeRow);
+        if (error.Length()) AddRow(va("Status: %s", error.c_str()), MP_CMD_BACK, true);
+        AddRow("Back", MP_CMD_BACK);
+        break;
+    }
+    case PAGE_ROOM: {
+        const bool coopRoom = BrowserBridge_GetNumber("mpRoomKind") == 1;
+        const bool host = peerId != 0 && peerId == hostPeerId;
+        SetHeading(coopRoom && host ? "Choose Campaign" : coopRoom ? "Co-Op" : "Multiplayer Lobby");
+        const int players = idMath::ClampInt(0, 8, BrowserBridge_GetNumber("mpRoomPlayers"));
+        const int maximum = idMath::ClampInt(2, 8, BrowserBridge_GetNumber("mpRoomMax"));
+        const idStr roomName = BrowserBridge_GetText("mpRoomName", "Lobby");
+        if (!coopRoom || !host) AddRow(va("%s  %d/%d players", roomName.c_str(), players, maximum), MP_CMD_BACK, true);
+        for (int i = 0; i < ((!coopRoom || !host) ? players : 0); ++i) {
+            const idStr name = BrowserBridge_GetText(va("mpRoster%d", i), "Player");
+            AddRow(i == 0 ? va("%s (Host)", name.c_str()) : name.c_str(), MP_CMD_BACK, true);
+        }
+        if (host && BrowserBridge_GetNumber("mpPrivate")) {
+            const idStr code = BrowserBridge_GetText("mpPrivateCode", "");
+            // A press copies the code to the clipboard and confirms with a
+            // native dialog; the row is actionable rather than a grey label.
+            AddRow(va("Invite code: %s", code.c_str()), MP_CMD_COPY_CODE);
+        }
+        if (host && !coopRoom) {
+            AddRow(BrowserBridge_GetNumber("mpPrivate") ? "Privacy: Private" : "Privacy: Public",
+                MP_CMD_ROOM_PRIVACY);
+        }
+        if (coopRoom) {
+            const int saveState = cvarSystem->GetCVarInteger("web_coop_save_state");
+            bool hasUsableSave = false;
+            const saveGameDetailsList_t& saves = session->GetSaveGameManager().GetEnumeratedSavegames();
+            for (int i = 0; i < saves.Num(); ++i) {
+                if (!saves[i].damaged && saves[i].GetSaveVersion() <= BUILD_NUMBER) {
+                    hasUsableSave = true;
+                    break;
+                }
+            }
+            const bool canChooseSave = host && hasUsableSave && !session->GetSaveGameManager().IsWorking();
+            if (host) {
+                AddRow("Continue Game", MP_CMD_CONTINUE, !canChooseSave || saveState == 1 || pendingCoopSaveCommand != 0);
+                AddRow("Load Game", MP_CMD_LOAD_SAVE, !canChooseSave || saveState == 1 || pendingCoopSaveCommand != 0);
+                if (saveState == 1 || pendingCoopSaveCommand != 0) AddRow("Preparing campaign...", MP_CMD_BACK, true);
+                else if (!hasUsableSave) AddRow("Save a campaign in single-player first", MP_CMD_BACK, true);
+            } else {
+                AddRow(BrowserBridge_GetNumber("mpHostLoading") ? "Waiting for host to load the level..." : "Waiting for the host's campaign", MP_CMD_BACK, true);
+            }
+        } else {
+            const bool canStart = host && players >= 2 && BrowserBridge_GetNumber("mpStarted") == 0;
+            AddRow(players < 2 ? "Waiting for another player" : "Start game", MP_CMD_START, !canStart);
+        }
+        if (error.Length()) AddRow(va("Status: %s", error.c_str()), MP_CMD_BACK, true);
+        AddRow(coopRoom && host ? "Back" : "Leave lobby", MP_CMD_LEAVE);
+        break;
+    }
+    }
+    if (renderedPage == page && options->GetChildren().Num()) {
+        const int view = idMath::ClampInt(0, options->GetChildren().Num() - 1, oldView);
+        const int offset = idMath::ClampInt(0, view, oldOffset);
+        options->SetViewOffset(offset);
+        options->SetViewIndex(view);
+        options->SetFocusIndex(view - offset, true);
+    } else if (options->GetChildren().Num()) {
+        // Focus after children exist. Setting it on the emptied list leaves
+        // its previous logical index alive (for example Co-Op's Back row).
+        SetFocusIndex(0, true);
+        const int index = idMath::ClampInt(0, options->GetChildren().Num() - 1, restoreFocus < 0 ? 0 : restoreFocus);
+        const int offset = Max(0, index - WEB_MULTIPLAYER_VISIBLE_ROWS + 1);
+        options->SetViewIndex(index);
+        options->SetViewOffset(offset);
+        options->SetFocusIndex(index - offset, true);
+    }
+    restoreFocus = -1;
+    renderedPage = page;
+    if (BindSprite(GetSWFObject()->GetRootObject())) BrowserBridge_SubpageTransition(GetSprite(), menuData, "_webMultiplayerPage", page);
+    options->Update();
+}
+
+void idMenuScreen_Shell_WebMultiplayer::Update()
+{
+    const int revision = BrowserBridge_GetNumber("mpRevision", -1);
+    const bool inRoom = BrowserBridge_GetNumber("mpInRoom") != 0;
+    if (inRoom && page != PAGE_ROOM) {
+        page = PAGE_ROOM;
+        editing = EDIT_NONE;
+        localError.Clear();
+        BuildPage();
+    } else if (!inRoom && page == PAGE_ROOM) {
+        page = PAGE_HOME;
+        editing = EDIT_NONE;
+        pendingCoopSaveCommand = 0;
+        pendingCampaign = false;
+        autoStartCoop = false;
+        BuildPage();
+    }
+    if (pendingAction != MP_PENDING_NONE && BrowserBridge_GetNumber("mpStatus") == 2) {
+        const int pending = pendingAction;
+        pendingAction = MP_PENDING_NONE;
+        if (pending == MP_PENDING_CREATE_VERSUS || pending == MP_PENDING_CREATE_COOP) {
+            coopFlow = pending == MP_PENDING_CREATE_COOP;
+            page = PAGE_CREATE;
+            if (lobbyName.Length() == 0) lobbyName = va("%s's game", BrowserBridge_GetText("profileName", "Marine").c_str());
+        } else {
+            RequestJoinList(pending == MP_PENDING_JOIN_COOP ? 1 : 0);
+        }
+        BuildPage();
+    } else if (revision != renderedRevision) {
+        BuildPage();
+    }
+    if (pendingCampaign && inRoom && BrowserBridge_GetNumber("mpIsHost") &&
+        session->GetState() == idSession::PARTY_LOBBY && !session->GetSaveGameManager().IsWorking()) {
+        pendingCampaign = false;
+        BrowserBridge_Action(coopDevChoice ? "mpOpenCoopDevPicker" : "mpOpenCoopCampaignPicker");
+        if (menuData) menuData->SetNextScreen(coopDevChoice ? SHELL_AREA_DEV : SHELL_AREA_CAMPAIGN, MENU_TRANSITION_SIMPLE);
+    }
+    const int coopSaveState = cvarSystem->GetCVarInteger("web_coop_save_state");
+    const idStr coopSaveMap = cvarSystem->GetCVarString("web_coop_save_map");
+    const int saveCount = session->GetSaveGameManager().GetEnumeratedSavegames().Num();
+    const bool saveBusy = session->GetSaveGameManager().IsWorking();
+    if (coopSaveState != lastCoopSaveState || coopSaveMap != lastCoopSaveMap || saveCount != lastSaveCount || saveBusy != lastSaveBusy) {
+        lastCoopSaveState = coopSaveState;
+        lastCoopSaveMap = coopSaveMap;
+        lastSaveCount = saveCount;
+        lastSaveBusy = saveBusy;
+        if ((page == PAGE_ROOM || page == PAGE_CREATE) && coopFlow) BuildPage();
+    }
+    // Create Game chooses a save first; wait for the asynchronous native party
+    // before preflighting it, then start the host without waiting for a guest.
+    if (pendingCoopSaveCommand && inRoom && BrowserBridge_GetNumber("mpIsHost") &&
+        session->GetState() == idSession::PARTY_LOBBY && !saveBusy) {
+        const int command = pendingCoopSaveCommand;
+        pendingCoopSaveCommand = 0;
+        if (command == MP_CMD_CONTINUE) {
+            if (!StartNewestBrowserCoopSaveLoad()) {
+                localError = "No usable campaign save is available.";
+                autoStartCoop = false;
+                BuildPage();
+            }
+        } else {
+            BrowserBridge_Action("mpOpenCoopSavePicker");
+            if (BrowserBridge_GetNumber("mpCoopSavePicker") && menuData) menuData->SetNextScreen(SHELL_AREA_LOAD, MENU_TRANSITION_SIMPLE);
+        }
+    }
+    if (autoStartCoop && inRoom && coopSaveState == 2 && !BrowserBridge_GetNumber("mpStarted")) {
+        autoStartCoop = false;
+        BrowserBridge_Action("mpStart");
+    }
+    renderedRevision = revision;
+
+    const idStr error = BrowserBridge_GetText("mpError", "");
+    if (error.Length()) {
+        pendingCoopSaveCommand = 0;
+        pendingCampaign = false;
+        autoStartCoop = false;
+    }
+    if (error == "FULL" && revision != lastFullErrorRevision) {
+        lastFullErrorRevision = revision;
+        ShowFullError();
+        BrowserBridge_Action("mpClearError");
+    }
+
+    // Widget callbacks only request changes. Their active button must survive
+    // ExecuteEvent's remaining actions and observer notifications.
+    if (pageDirty) {
+        pageDirty = false;
+        if (menuData) menuData->ClearWidgetActionRepeater();
+        RebuildPage();
+    }
+
+    idSWFScriptObject& root = GetSWFObject()->GetRootObject();
+    if (menuData && menuData->GetCmdBar()) {
+        idMenuWidget_CommandBar* bar = menuData->GetCmdBar();
+        bar->ClearAllButtons();
+        bar->GetButton(idMenuWidget_CommandBar::BUTTON_JOY2)->label = "Back";
+        bar->GetButton(idMenuWidget_CommandBar::BUTTON_JOY2)->action.Set(WIDGET_ACTION_GO_BACK);
+        bar->GetButton(idMenuWidget_CommandBar::BUTTON_JOY1)->action.Set(WIDGET_ACTION_PRESS_FOCUSED);
+    }
+    if (btnBack) {
+        btnBack->SetLabel(page == PAGE_HOME ? "MAIN MENU"
+            : (page == PAGE_CREATE || page == PAGE_JOIN) && coopFlow ? "CO-OP"
+            : "MULTIPLAYER");
+        btnBack->BindSprite(root);
+    }
+    idMenuHandler_Shell* shell = dynamic_cast<idMenuHandler_Shell*>(menuData);
+    if (shell) {
+        // The authored pacifier is the native "scanning" animation; reuse it for
+        // the co-op handoff so the page stays put while the campaign is prepared.
+        const bool scanning = page == PAGE_JOIN && BrowserBridge_GetNumber("mpScanning");
+        const bool connecting = page == PAGE_ROOM && coopFlow &&
+            (cvarSystem->GetCVarInteger("web_coop_save_state") == 1 || pendingCoopSaveCommand != 0 || pendingCampaign);
+        if (scanning) {
+            if (!shell->IsPacifierVisible()) shell->ShowPacifier("Scanning rooms...");
+        } else if (connecting) {
+            if (!shell->IsPacifierVisible()) shell->ShowPacifier("Connecting to game...");
+        } else if (shell->IsPacifierVisible()) {
+            shell->HidePacifier();
+        }
+    }
+    idMenuScreen::Update();
+    BrowserBridge_UpdateTransition(GetSprite());
+    // Authored rollOn frames restore their placeholder; keep the active title.
+    SetHeading(pageHeading.c_str());
+}
+
+void idMenuScreen_Shell_WebMultiplayer::DrawMapPreview()
+{
+#ifdef __EMSCRIPTEN__
+    // The preview belongs to every multiplayer entry that knows its level:
+    // the versus create page, the co-op create page (from the chosen save) and
+    // an open room (its host-selected map).
+    if (page != PAGE_CREATE && page != PAGE_ROOM) return;
+    idStr map;
+    if (page == PAGE_ROOM) {
+        map = BrowserBridge_GetText("mpRoomMap", "");
+    } else if (coopFlow) {
+        map = cvarSystem->GetCVarString("web_coop_save_map");
+    } else {
+        const idList<mpMap_t>& maps = common->GetMapList();
+        if (!maps.Num()) return;
+        map = maps[idMath::ClampInt(0, maps.Num() - 1, mapIndex)].mapFile;
+    }
+    map.StripPath(); map.StripFileExtension();
+    if (!map.Length()) return;
+    if (previewMap != map) {
+        common->Printf("[web-port menu] requesting map preview %s\n", map.c_str());
+        previewMap = map;
+        previewMaterial = NULL;
+        if (fileSystem->ReadFile(va("generated/images/guis/assets/loadscreens/%s#__0200.bimage", map.c_str()), NULL, NULL) >= 0) {
+            previewMaterial = declManager->FindMaterial(va("guis/assets/loadscreens/%s", map.c_str()));
+        } else {
+        EM_ASM({
+            const map = UTF8ToString($0);
+            out('[DOOM 3 BFG Web] Map preview worker loader: ' + typeof Module['stageMapLoadingImage']);
+            const old = Module['webMPPreviewMap'];
+            Module['webMPPreviewMap'] = map;
+            Module['webMPPreviewReady'] = 0;
+            if (old && old !== map && Module['releaseMapLoadingImage']) Module['releaseMapLoadingImage'](old);
+            Promise.resolve().then(() => Module['stageMapLoadingImage']('game/' + map)).then(ok => {
+                if (Module['webMPPreviewMap'] === map) Module['webMPPreviewReady'] = ok ? 1 : -1;
+                else if (Module['releaseMapLoadingImage']) Module['releaseMapLoadingImage'](map);
+            }).catch(error => {
+                if (Module['webMPPreviewMap'] === map) Module['webMPPreviewReady'] = -1;
+                err('[DOOM 3 BFG Web] Map preview failed: ' + String(error));
+            });
+        }, map.c_str());
+        }
+    }
+    if (!previewMaterial && EM_ASM_INT({ return Module['webMPPreviewMap'] === UTF8ToString($0) && Module['webMPPreviewReady'] === 1; }, map.c_str())) {
+        previewMaterial = declManager->FindMaterial(va("guis/assets/loadscreens/%s", map.c_str()));
+        for (int i = 0; i < previewMaterial->GetNumStages(); ++i) {
+            const shaderStage_t* stage = previewMaterial->GetStage(i);
+            if (stage && stage->texture.image) stage->texture.image->Reload(true);
+        }
+        renderSystem->LoadLevelImages();
+    }
+    if (previewMaterial) {
+        // Right-hand accessory column, inside the panel rather than below it.
+        if (options && !pageDirty) GetSWFObject()->DrawMaterialOnSprite(options->GetSprite(), 516, 40, 264, 148, previewMaterial);
+    }
+#endif
+}
