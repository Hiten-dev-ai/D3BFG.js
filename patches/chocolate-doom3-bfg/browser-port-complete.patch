+/*
+===============
+Web multiplayer session bridge
+===============
+*/
+#ifdef __EMSCRIPTEN__
+struct webMultiplayerRoom_t {
+    char id[96];
+    char kind[16];
+    char mode[32];
+    char map[128];
+    uint32 peerId;
+    uint32 hostPeerId;
+    int players;
+    int maxPlayers;
+    int isPrivate;
+    int started;
+    int coopLives;
+    int friendlyFire;
+    int hostLoading;
+};
+
+static bool WebMultiplayer_ReadRoom(webMultiplayerRoom_t& room)
+{
+    memset(&room, 0, sizeof(room));
+    if (EM_ASM_INT({
+        const state = Module['browserDisplayState'];
+        return state && state.length >= 8 && !Atomics.load(state, 5) ? 1 : 0;
+    })) return false;
+    return MAIN_THREAD_EM_ASM_INT({
+        const service = window.doom3Multiplayer;
+        const state = service && service.state;
+        const lobby = state && state.lobby;
+        if (!state || state.status !== 'connected' || !lobby) return 0;
+
+        const peerId = Number(state.peerId);
+        const hostPeerId = Number(lobby.hostPeerId);
+        if (!Number.isSafeInteger(peerId) || peerId <= 0 || peerId > 0xffffffff ||
+            !Number.isSafeInteger(hostPeerId) || hostPeerId <= 0 || hostPeerId > 0xffffffff) return 0;
+
+        stringToUTF8(String(lobby.id || '').slice(0, 95), $0, 96);
+        stringToUTF8(String(lobby.kind || '').slice(0, 15), $1, 16);
+        stringToUTF8(String(lobby.mode || '').slice(0, 31), $2, 32);
+        stringToUTF8(String(lobby.map || '').slice(0, 127), $3, 128);
+        HEAPU32[$4 >> 2] = peerId >>> 0;
+        HEAPU32[$5 >> 2] = hostPeerId >>> 0;
+        HEAP32[$6 >> 2] = Math.max(0, Math.min(64, Number(lobby.players) | 0));
+        HEAP32[$7 >> 2] = Math.max(0, Math.min(64, Number(lobby.maxPlayers) | 0));
+        HEAP32[$8 >> 2] = lobby.private ? 1 : 0;
+        HEAP32[$9 >> 2] = (state.started || lobby.started) ? 1 : 0;
+        HEAP32[$10 >> 2] = Math.max(1, Math.min(10, Number(lobby.coopLives) || 3));
+        HEAP32[$11 >> 2] = lobby.friendlyFire === true ? 1 : 0;
+        HEAP32[$12 >> 2] = lobby.hostLoading === true ? 1 : 0;
+        return 1;
+    }, room.id, room.kind, room.mode, room.map, &room.peerId, &room.hostPeerId,
+       &room.players, &room.maxPlayers, &room.isPrivate, &room.started, &room.coopLives, &room.friendlyFire, &room.hostLoading) != 0;
+}
+
+static void WebMultiplayer_ReportNativeError()
+{
+    MAIN_THREAD_ASYNC_EM_ASM({
+        const bridge = window.doom3BrowserBridge;
+        if (bridge && typeof bridge.action === 'function') {
+            bridge.action('mpNativeError|Could not connect to the native multiplayer session.');
+        }
+    });
+}
+#endif
