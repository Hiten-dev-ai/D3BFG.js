diff --git a/neo/d3xp/menus/MenuScreen_Shell_BrowserBridge.h b/neo/d3xp/menus/MenuScreen_Shell_BrowserBridge.h
new file mode 100644
--- /dev/null
+++ b/neo/d3xp/menus/MenuScreen_Shell_BrowserBridge.h
@@ -0,0 +1,154 @@
+#ifndef __MENUSCREEN_SHELL_BROWSERBRIDGE_H__
+#define __MENUSCREEN_SHELL_BROWSERBRIDGE_H__
+
+#if defined(__EMSCRIPTEN__)
+#include <emscripten/em_asm.h>
+#endif
+
+// Subpages share the authored settings sprite, so play its native entrance
+// only on navigation, never on roster/status/slider refreshes.
+static void BrowserBridge_SubpageTransition(idSWFSpriteInstance* sprite, idMenuHandler* data, const char* key, int page, bool reset = false)
+{
+    if (!sprite) return;
+    idSWFScriptObject* state = sprite->GetScriptObject();
+    const idSWFScriptVar previous = state->Get(key);
+    state->Set(key, page);
+    if (reset) {
+        state->Set("_webFadeStart", Sys_Milliseconds());
+        state->Set("_webFadeOut", false);
+        state->Set("_webFadeDuration", 160);
+        return; // The base ShowScreen already plays the authored entrance/sound.
+    }
+    if (previous.IsUndefined() || previous.ToInteger() == page) return;
+    state->Set("_webFadeOut", false);
+    sprite->SetVisible(true);
+    if (data) data->PlaySound(GUI_SOUND_BUILD_ON);
+    // The panel is already open when navigating between browser subpages.
+    // Replaying its full rollOn closes/reopens the backdrop and flashes the
+    // authored placeholders. Animate only its list, when that clip supports it.
+    idSWFSpriteInstance* options = state->GetNestedSprite("info", "options");
+    if (options && options->FrameExists("rollOn")) options->PlayFrame("rollOn");
+    // Some shipped SWFs have no rollOn label on the list itself. A real,
+    // time-based fade must still run; it never gates input or network actions.
+    state->Set("_webFadeStart", Sys_Milliseconds());
+}
+
+static void BrowserBridge_UpdateTransition(idSWFSpriteInstance* sprite)
+{
+    if (!sprite) return;
+    idSWFScriptObject* state = sprite->GetScriptObject();
+    const idSWFScriptVar started = state->Get("_webFadeStart");
+    if (started.IsUndefined()) return;
+    // SWF timelines overwrite alpha during Render(), after menu Update().
+    // The renderer applies this duration to its final render colour instead.
+    state->Set("_webFadeDuration", 160);
+}
+
+static void BrowserBridge_RefreshSnapshot()
+{
+#if defined(__EMSCRIPTEN__)
+    EM_ASM({
+        const state = Module['browserDisplayState'];
+        if (!state || state.length < 16396) return;
+        const version = Atomics.load(state, 9);
+        if (!version || (version & 1) || Module['webMenuVersion'] === version) return;
+        const length = Atomics.load(state, 10);
+        if (length <= 0 || length > 65536) return;
+        const bytes = new Uint8Array(state.buffer, state.byteOffset + 48, length).slice();
+        if (Atomics.load(state, 9) !== version) return;
+        try {
+            Module['webMenuSnapshot'] = JSON.parse(new TextDecoder().decode(bytes));
+            Module['webMenuVersion'] = version;
+        } catch (_) {}
+    });
+#endif
+}
+
+static int BrowserBridge_GetNumber(const char* key, int fallback = 0)
+{
+#if defined(__EMSCRIPTEN__)
+    BrowserBridge_RefreshSnapshot();
+    return EM_ASM_INT({
+        const snapshot = Module['webMenuSnapshot'];
+        if (!snapshot) return $1;
+        const value = Number(snapshot.numbers[UTF8ToString($0)]);
+        return Number.isFinite(value) ? value : $1;
+    }, key, fallback);
+#else
+    (void)key;
+    return fallback;
+#endif
+}
+
+static idStr BrowserBridge_GetText(const char* key, const char* fallback = "")
+{
+#if defined(__EMSCRIPTEN__)
+    char text[256] = {};
+    BrowserBridge_RefreshSnapshot();
+    EM_ASM({
+        const snapshot = Module['webMenuSnapshot'];
+        const value = snapshot
+            ? String(snapshot.texts[UTF8ToString($0)] || '')
+            : UTF8ToString($3);
+        stringToUTF8(value, $1, $2);
+    }, key, text, sizeof(text), fallback);
+    return text;
+#else
+    (void)key;
+    return fallback;
+#endif
+}
+
+static void BrowserBridge_SetNumber(const char* key, int value)
+{
+#if defined(__EMSCRIPTEN__)
+    if (!idStr::Cmp(key, "skipIntro")) cvarSystem->SetCVarBool("g_webSkipCinematics", value != 0);
+    if (!idStr::Cmp(key, "developerMenu")) cvarSystem->SetCVarBool("web_developerMenu", value != 0);
+    MAIN_THREAD_ASYNC_EM_ASM({
+        const bridge = window.doom3BrowserBridge;
+        if (bridge && typeof bridge.setNumber === 'function') {
+            bridge.setNumber(UTF8ToString($0), $1);
+        }
+    }, key, value);
+#else
+    (void)key;
+    (void)value;
+#endif
+}
+
+static void BrowserBridge_Action(const char* action)
+{
+#if defined(__EMSCRIPTEN__)
+    // Network/UI-only actions cannot rendezvous with a busy DOM thread.
+    // Copy the payload onto libc's heap before queueing: callers often pass
+    // temporary idStr/va storage. Local picker acknowledgements remain ordered.
+    const bool picker = !idStr::Cmp(action, "mpOpenCoopSavePicker") || !idStr::Cmp(action, "mpCloseCoopSavePicker") ||
+        !idStr::Cmp(action, "mpOpenCoopCampaignPicker") || !idStr::Cmp(action, "mpCloseCoopCampaignPicker") ||
+        !idStr::Cmp(action, "mpOpenCoopDevPicker") || !idStr::Cmp(action, "mpBeginCoopConnect");
+    if (!idStr::Cmpn(action, "mp", 2) && !picker) {
+        char* owned = (char*)malloc(strlen(action) + 1);
+        if (!owned) return;
+        strcpy(owned, action);
+        MAIN_THREAD_ASYNC_EM_ASM({
+            try {
+                const bridge = window.doom3BrowserBridge;
+                if (bridge) { bridge.action(UTF8ToString($0)); bridge.publishSnapshot?.(); }
+            } finally { _free($0); }
+        }, owned);
+        return;
+    }
+    // Decode before the caller's idStr can be destroyed. Async browser work
+    // starts inside bridge.action after this short synchronous dispatch.
+    MAIN_THREAD_EM_ASM({
+        const bridge = window.doom3BrowserBridge;
+        if (bridge && typeof bridge.action === 'function') {
+            bridge.action(UTF8ToString($0));
+            if (typeof bridge.publishSnapshot === 'function') bridge.publishSnapshot();
+        }
+    }, action);
+#else
+    (void)action;
+#endif
+}
+
+#endif
