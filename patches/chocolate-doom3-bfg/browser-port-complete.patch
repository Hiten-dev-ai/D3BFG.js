+void idMenuScreen_Shell_WebMultiplayer::CycleMode(int amount)
+{
+    const idStrList& modes = common->GetModeList();
+    const int count = Min(5, modes.Num());
+    if (count <= 0) return;
+    modeIndex = (modeIndex + amount + count) % count;
+    CycleMap(1);
+}
+
+void idMenuScreen_Shell_WebMultiplayer::CycleMap(int amount)
+{
+    const idList<mpMap_t>& maps = common->GetMapList();
+    if (maps.Num() <= 0) return;
+    const int count = maps.Num();
+    const uint32 modeBit = BIT(modeIndex);
+    for (int i = 0; i < count; ++i) {
+        mapIndex = (mapIndex + amount + count) % count;
+        if (coopFlow || (maps[mapIndex].supportedModes & modeBit) != 0) return;
+    }
+}
