+static void BrowserAccountConfirm(const idStr& action, const idStr& message, const char* confirmLabel)
+{
+    class ConfirmAction : public idSWFScriptFunction_RefCounted {
+    public:
+        explicit ConfirmAction(const idStr& value) : action(value) {}
+        idSWFScriptVar Call(idSWFScriptObject*, const idSWFParmList&) {
+            const idStr pending = action;
+            common->Dialog().ClearDialog(GDM_GAME_RESTART_REQUIRED);
+            if (pending.Length()) BrowserBridge_Action(pending.c_str());
