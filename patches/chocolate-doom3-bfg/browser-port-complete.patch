+            && (!glConfig.textureCompressionAvailable || s3tcDimensionFallback))
+        || opts.format == FMT_ALPHA
+        || opts.format == FMT_L8A8
+        || opts.format == FMT_LUM8
+        || opts.format == FMT_INT8
+        || opts.format == FMT_X16
+        || opts.format == FMT_Y16_X16;
+}
+
+static int WebGLSourceBytesPerPixel(textureFormat_t format)
+{
+    switch (format) {
+    case FMT_ALPHA:
+    case FMT_LUM8:
+    case FMT_INT8:
+        return 1;
+    case FMT_L8A8:
+    case FMT_X16:
+    case FMT_RGB565:
+        return 2;
+    case FMT_Y16_X16:
+        return 4;
+    case FMT_RGBA8:
+    case FMT_XRGB8:
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static byte WebGLNormalize16To8(unsigned short value)
+{
+    return (byte)((value * 255u + 32767u) / 65535u);
+}
+
+static void WebGLExpandTexturePixels(const byte* source, textureFormat_t format, textureColor_t colorFormat,
+    int width, int height, int sourceRowPixels, byte* destination)
+{
+    const int sourceBytesPerPixel = WebGLSourceBytesPerPixel(format);
+    assert(sourceBytesPerPixel > 0);
+
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x) {
+            const byte* src = source + ((size_t)y * sourceRowPixels + x) * sourceBytesPerPixel;
+            byte* dst = destination + ((size_t)y * width + x) * 4;
+            if (colorFormat == CFM_GREEN_ALPHA) {
+                byte green = 0;
+                switch (format) {
+                case FMT_RGBA8:
+                case FMT_XRGB8:
+                    green = src[1];
+                    break;
+                case FMT_L8A8:
+                    green = src[1];
+                    break;
+                case FMT_RGB565: {
+                    // BinaryImage stores packed 565 pixels in big-endian byte order.
+                    const unsigned short pixel = (unsigned short)(((unsigned short)src[0] << 8) | src[1]);
+                    green = (byte)((((pixel >> 5) & 0x3fu) * 255u + 31u) / 63u);
+                } break;
+                case FMT_X16:
+                    green = WebGLNormalize16To8(((const unsigned short*)src)[0]);
+                    break;
+                case FMT_Y16_X16:
+                    green = WebGLNormalize16To8(((const unsigned short*)src)[0]);
+                    break;
+                default:
+                    break;
+                }
+                dst[0] = dst[1] = dst[2] = 255;
+                dst[3] = green;
+                continue;
+            }
+
+            switch (format) {
+            case FMT_ALPHA:
+                dst[0] = dst[1] = dst[2] = 255;
+                dst[3] = src[0];
+                break;
+            case FMT_LUM8:
+                dst[0] = dst[1] = dst[2] = src[0];
+                dst[3] = 255;
+                break;
+            case FMT_L8A8:
+                dst[0] = dst[1] = dst[2] = src[0];
+                dst[3] = src[1];
+                break;
+            case FMT_INT8:
+                dst[0] = dst[1] = dst[2] = dst[3] = src[0];
+                break;
+            case FMT_X16: {
+                const byte value = WebGLNormalize16To8(((const unsigned short*)src)[0]);
+                dst[0] = dst[1] = dst[2] = dst[3] = value;
+            } break;
+            case FMT_Y16_X16: {
+                const unsigned short* value = (const unsigned short*)src;
+                dst[0] = dst[1] = dst[2] = WebGLNormalize16To8(value[0]);
+                dst[3] = WebGLNormalize16To8(value[1]);
+            } break;
+            default:
+                memcpy(dst, src, 4);
+                break;
+            }
