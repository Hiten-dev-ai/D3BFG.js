+void idMenuScreen_Shell_WebSettings::UpdateProfileField(int field)
+{
+    if (field < 0 || field >= 5 || !profileFieldControls[field]) return;
+    static const char* labels[] = { "Name", "Email", "Current password", "New password", "Confirm password" };
+    idStr shown = profileFields[field];
+    if (field >= 2) {
+        shown.Clear();
+        for (int i = 0; i < Min(18, profileFields[field].Length()); ++i) shown.Append('*');
+    }
+    profileFieldControls[field]->SetLabel(va("%s: %s%s", labels[field], shown.c_str(), profileEditing == field ? "_" : ""));
+}
