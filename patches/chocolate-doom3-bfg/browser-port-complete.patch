+void idMenuScreen_Shell_WebSettings::RebuildBrowserRows()
+{
+    if (!options) return;
+    options->RemoveAllChildren();
+    profileControl = NULL;
+    profileStatusControl = NULL;
+    for (int i = 0; i < 5; ++i) profileFieldControls[i] = NULL;
+    options->SetFocusIndex(0, true);
+    options->SetViewIndex(0);
+    options->SetViewOffset(0);
+    options->SetNumVisibleOptions(8);
+    auto row = [&](const char* label, int command, int field = -1) {
+        idMenuWidget_ControlButton* control = new (TAG_SWF) idMenuWidget_ControlButton();
+        control->Initialize(menuData);
+        control->SetOptionType(field < 0 ? OPTION_BUTTON_TEXT : OPTION_SLIDER_TEXT);
+        control->SetLabel(label);
+        if (field >= 0) {
+            control->SetDataSource(&browserData, field);
+            control->SetupEvents(DEFAULT_REPEAT_TIME, options->GetChildren().Num());
+        }
+        control->AddEventAction(WIDGET_EVENT_PRESS).Set(WIDGET_ACTION_COMMAND, command);
+        options->AddChild(control);
+        return control;
+    };
+    if (profilePage == 0) {
+        profileName = BrowserBridge_GetText("profileName", "Marine");
+        profileControl = row(va("Manage profile: %s", profileName.c_str()), 106);
+        if (BrowserBridge_GetNumber("offline")) {
+            row("Status: Offline - multiplayer and level downloads are unavailable", 410)->SetDisabled(true);
+        }
+        idMenuWidget_ControlButton* cacheControl = row("Asset caching", 101, idMenuDataSource_BrowserSettings::BROWSER_FIELD_CACHE_MODE);
+        cacheControl->SetOptionType(OPTION_SLIDER_TEXT);
+        cacheControl->SetDisabled(false);
+        cacheControl->SetDescription("Use the left/right arrows to cycle None, Shared data, Visited levels, or All game data. Offline play requires cached data.");
+        row("Cached data", 105, idMenuDataSource_BrowserSettings::BROWSER_FIELD_STORAGE_SUMMARY)->SetDisabled(true);
+        row("Clear all local data", 300);
+        row("Restart game", 302);
+        row("Delete account", 303)->SetDescription("Permanently delete this account and all its saves. Confirmation is required.");
+    } else {
+        if (profilePage == 1) {
+            for (int i = 0; i < 2; ++i) { profileFieldControls[i] = row("", 700 + i); UpdateProfileField(i); }
+            row("Save profile", 710);
+            row("Change password", 711);
+            row("Delete account", 712);
+            row("Log out", 713);
+        } else {
+            for (int i = 2; i < (profilePage == 2 ? 5 : 3); ++i) { profileFieldControls[i] = row("", 700 + i); UpdateProfileField(i); }
+            row(profilePage == 2 ? "Change password" : "Delete account permanently", profilePage == 2 ? 714 : 715)
+                ->SetDescription(profilePage == 2 ? "Confirm your current and new passwords." : "All profile data and saved games for this account will be lost.");
+        }
+        profileStatus = BrowserBridge_GetText("accountStatus");
+        profileStatusControl = row(profileStatus.Length() ? profileStatus.c_str() : "Select a field to edit; Enter finishes editing.", 716);
+        profileStatusControl->SetDisabled(true);
+    }
+    if (BindSprite(GetSWFObject()->GetRootObject())) BrowserBridge_SubpageTransition(GetSprite(), menuData, "_webProfilePage", profilePage);
+    options->Update();
+}
