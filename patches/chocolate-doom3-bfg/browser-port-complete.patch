+idMenuScreen_Shell_WebSettings::idMenuDataSource_AudioSettings::idMenuDataSource_AudioSettings() {}
+void idMenuScreen_Shell_WebSettings::idMenuDataSource_AudioSettings::LoadData() {
+    originalMusicVolume = cvarSystem->GetCVarFloat("s_musicVolume");
+    originalGameVolume = cvarSystem->GetCVarFloat("s_gameVolume");
+}
+void idMenuScreen_Shell_WebSettings::idMenuDataSource_AudioSettings::CommitData() { cvarSystem->SetModifiedFlags(CVAR_ARCHIVE); }
+bool idMenuScreen_Shell_WebSettings::idMenuDataSource_AudioSettings::IsDataChanged() const {
+    return originalMusicVolume != cvarSystem->GetCVarFloat("s_musicVolume") || originalGameVolume != cvarSystem->GetCVarFloat("s_gameVolume");
+}
+idSWFScriptVar idMenuScreen_Shell_WebSettings::idMenuDataSource_AudioSettings::GetField(int field) const {
+    if (field == AUDIO_FIELD_PAUSE_UNFOCUSED) return BrowserBridge_GetNumber("pauseAudioUnfocused", 1) ? "Enabled" : "Disabled";
+    return 100.0f * cvarSystem->GetCVarFloat(field == AUDIO_FIELD_MUSIC_VOLUME ? "s_musicVolume" : "s_gameVolume");
+}
+void idMenuScreen_Shell_WebSettings::idMenuDataSource_AudioSettings::AdjustField(int field, int amount) {
+    if (field == AUDIO_FIELD_PAUSE_UNFOCUSED) { BrowserBridge_SetNumber("pauseAudioUnfocused", BrowserBridge_GetNumber("pauseAudioUnfocused", 1) ? 0 : 1); return; }
+    const char* key = field == AUDIO_FIELD_MUSIC_VOLUME ? "s_musicVolume" : "s_gameVolume";
+    cvarSystem->SetCVarFloat(key, idMath::ClampFloat(0.0f, 1.0f, cvarSystem->GetCVarFloat(key) + amount * 0.01f));
+}
