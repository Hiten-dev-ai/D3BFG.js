     backEnd.glState.currenttmu = unit;
 }
 
+/*
+========================
+GL_BindTextureToCurrentUnit
+========================
+Bind an image texture to the renderer's logical unit and keep its cache in sync.
+This also avoids relying on whichever physical unit was last made active by a
+fallback glBindMultiTextureEXT implementation.
+========================
+*/
+void GL_BindTextureToCurrentUnit(GLenum target, GLuint texture)
+{
+    const int unit = backEnd.glState.currenttmu;
+    assert(unit >= 0 && unit < glConfig.maxTextureImageUnits);
+    assert(unit < MAX_MULTITEXTURE_UNITS);
+
+    qglActiveTextureARB(GL_TEXTURE0_ARB + unit);
+    qglBindTexture(target, texture);
+
+    if (target == GL_TEXTURE_2D) {
+        backEnd.glState.tmu[unit].current2DMap = texture;
+    } else if (target == GL_TEXTURE_CUBE_MAP_EXT) {
+        backEnd.glState.tmu[unit].currentCubeMap = texture;
+    }
+}
