diff --git a/neo/sys/sdl/sdl_events.cpp b/neo/sys/sdl/sdl_events.cpp
--- a/neo/sys/sdl/sdl_events.cpp
+++ b/neo/sys/sdl/sdl_events.cpp
@@ -40,6 +40,10 @@ If you have questions concerning this license or the applicable additional terms
 
 #include <SDL.h>
 
+#if defined(__EMSCRIPTEN__)
+#include <emscripten/html5.h>
+#endif
+
 #include "renderer/tr_local.h"
 #include "sdl_local.h"
 #include "../posix/posix_public.h"
@@ -762,8 +766,22 @@ sysEvent_t Sys_GetEvent()
                 r_windowWidth.SetInteger(w);
                 r_windowHeight.SetInteger(h);
 
+#if defined(__EMSCRIPTEN__)
+                int backingW = 0;
+                int backingH = 0;
+                if (emscripten_get_canvas_element_size("#canvas", &backingW, &backingH) == EMSCRIPTEN_RESULT_SUCCESS && backingW > 0 && backingH > 0) {
+                    glConfig.nativeScreenWidth = backingW;
+                    glConfig.nativeScreenHeight = backingH;
+                    r_windowWidth.SetInteger(backingW);
+                    r_windowHeight.SetInteger(backingH);
+                } else {
+                    glConfig.nativeScreenWidth = w;
+                    glConfig.nativeScreenHeight = h;
+                }
+#else
                 glConfig.nativeScreenWidth = w;
                 glConfig.nativeScreenHeight = h;
+#endif
                 break;
             }
 
diff --git a/neo/sys/sdl/sdl_glimp.cpp b/neo/sys/sdl/sdl_glimp.cpp
--- a/neo/sys/sdl/sdl_glimp.cpp
+++ b/neo/sys/sdl/sdl_glimp.cpp
@@ -43,9 +43,13 @@ If you have questions concerning this license or the applicable additional terms
 
 #if defined(__EMSCRIPTEN__)
 #include <emscripten/emscripten.h>
+#include <emscripten/html5.h>
 #endif
 
 #include "renderer/tr_local.h"
 #include "sdl_local.h"
 
+extern idCVar r_windowWidth;
+extern idCVar r_windowHeight;
+
 idCVar in_nograb("in_nograb", "0", CVAR_SYSTEM | CVAR_NOCHEAT, "prevents input grabbing");
@@ -294,6 +298,39 @@ bool GLimp_Init(glimpParms_t parms)
         SDL_GetWindowSize(window, &glConfig.nativeScreenWidth, &glConfig.nativeScreenHeight);
         // RB end
 
+#if defined(__EMSCRIPTEN__)
+        double cssW = 0.0;
+        double cssH = 0.0;
+        emscripten_get_element_css_size("#canvas", &cssW, &cssH);
+
+        int backingW = 0;
+        int backingH = 0;
+        emscripten_get_canvas_element_size("#canvas", &backingW, &backingH);
+
+        int sdlW = 0;
+        int sdlH = 0;
+        SDL_GetWindowSize(window, &sdlW, &sdlH);
+
+        int drawableW = 0;
+        int drawableH = 0;
+        SDL_GL_GetDrawableSize(window, &drawableW, &drawableH);
+
+        if (backingW > 0 && backingH > 0) {
+            glConfig.nativeScreenWidth = backingW;
+            glConfig.nativeScreenHeight = backingH;
+        } else if (drawableW > 0 && drawableH > 0) {
+            glConfig.nativeScreenWidth = drawableW;
+            glConfig.nativeScreenHeight = drawableH;
+        }
+
+        r_windowWidth.SetInteger(glConfig.nativeScreenWidth);
+        r_windowHeight.SetInteger(glConfig.nativeScreenHeight);
+
+        common->Printf("[web-port viewport] css=%.0fx%.0f backing=%dx%d sdl=%dx%d drawable=%dx%d engine=%dx%d\n",
+            cssW, cssH, backingW, backingH, sdlW, sdlH, drawableW, drawableH,
+            glConfig.nativeScreenWidth, glConfig.nativeScreenHeight);
+#endif
+
         glConfig.isFullscreen = (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN) == SDL_WINDOW_FULLSCREEN;
 #else
         glConfig.driverType = GLDRV_OPENGL3X;
@@ -493,8 +530,20 @@ bool GLimp_SetScreenParms(glimpParms_t parms)
 
     glConfig.isFullscreen = parms.fullScreen;
     glConfig.isStereoPixelFormat = parms.stereo;
+#if defined(__EMSCRIPTEN__)
+    int backingW = 0;
+    int backingH = 0;
+    if (emscripten_get_canvas_element_size("#canvas", &backingW, &backingH) == EMSCRIPTEN_RESULT_SUCCESS && backingW > 0 && backingH > 0) {
+        glConfig.nativeScreenWidth = backingW;
+        glConfig.nativeScreenHeight = backingH;
+    } else {
+        glConfig.nativeScreenWidth = parms.width;
+        glConfig.nativeScreenHeight = parms.height;
+    }
+#else
     glConfig.nativeScreenWidth = parms.width;
     glConfig.nativeScreenHeight = parms.height;
+#endif
     glConfig.displayFrequency = parms.displayHz;
     glConfig.multisamples = parms.multiSamples;
 
