diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1412,8 +1412,8 @@
     foreach(src_file ${DOOM_PRECOMPILED_SOURCES})
