     endforeach(item)
 
-    get_directory_property(_directory_flags DEFINITIONS)
-    list(APPEND _compiler_FLAGS ${_directory_flags})
+    get_directory_property(_directory_definitions COMPILE_DEFINITIONS)
+    foreach(item ${_directory_definitions})
+        list(APPEND _compiler_FLAGS "-D${item}")
+    endforeach()
-    separate_arguments(_compiler_FLAGS)
 
     # we need to recreate the precompiled header for Doom3BFG
@@ -1444,6 +1444,7 @@
             neo/idlib/precompiled.h -o neo/idlib/precompiled.h.gch
         WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
