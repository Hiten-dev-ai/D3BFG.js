diff --git a/neo/renderer/BinaryImage.cpp b/neo/renderer/BinaryImage.cpp
index d1a90f4..3e644b6 100644
--- a/neo/renderer/BinaryImage.cpp
+++ b/neo/renderer/BinaryImage.cpp
@@ -354,13 +354,29 @@ ID_TIME_T idBinaryImage::LoadFromGeneratedFile(ID_TIME_T sourceFileTime)
 {
     idStr binaryFileName;
     MakeGeneratedFileName(binaryFileName);
+#if defined(__EMSCRIPTEN__)
+    const bool webTraceFloorGrate = strstr(binaryFileName.c_str(), "textures/washroom/rffloorgrate01") != NULL;
+    if (webTraceFloorGrate) common->Printf("[web-port image] floorgrate binary image open started path=%s\n", binaryFileName.c_str());
+#endif
     idFileLocal bFile = fileSystem->OpenFileRead(binaryFileName);
+#if defined(__EMSCRIPTEN__)
+    if (webTraceFloorGrate) common->Printf("[web-port image] floorgrate binary image open returned found=%d bytes=%d\n", bFile != NULL, bFile != NULL ? bFile->Length() : 0);
+#endif
     if (bFile == NULL) {
         return FILE_NOT_FOUND_TIMESTAMP;
     }
+#if defined(__EMSCRIPTEN__)
+    if (webTraceFloorGrate) common->Printf("[web-port image] floorgrate binary image parse started\n");
+#endif
     if (LoadFromGeneratedFile(bFile, sourceFileTime)) {
+#if defined(__EMSCRIPTEN__)
+        if (webTraceFloorGrate) common->Printf("[web-port image] floorgrate binary image parse returned valid=1\n");
+#endif
         return bFile->Timestamp();
     }
+#if defined(__EMSCRIPTEN__)
+    if (webTraceFloorGrate) common->Printf("[web-port image] floorgrate binary image parse returned valid=0\n");
+#endif
     return FILE_NOT_FOUND_TIMESTAMP;
 }
 
