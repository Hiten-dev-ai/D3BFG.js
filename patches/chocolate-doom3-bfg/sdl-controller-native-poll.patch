+static void QueueControllerEvent(const sysEvent_t& event)
+{
+    if (pendingControllerEventCount >= MAX_PENDING_CONTROLLER_EVENTS) return;
+    const int writeIndex = (pendingControllerEventRead + pendingControllerEventCount) % MAX_PENDING_CONTROLLER_EVENTS;
+    pendingControllerEvents[writeIndex] = event;
+    ++pendingControllerEventCount;
+}
+
+static void QueueControllerKey(int device, int key, bool down)
+{
+    sysEvent_t event = {};
+    event.evType = SE_KEY;
+    event.evValue = key;
+    event.evValue2 = down ? 1 : 0;
+    event.inputDevice = device;
+    QueueControllerEvent(event);
+}
+
+static void QueueControllerJoystickEvent(int device, int axis, int value)
+{
+    sysEvent_t event = {};
+    event.evType = SE_JOYSTICK;
+    event.evValue = axis;
+    event.evValue2 = value;
+    event.inputDevice = device;
+    QueueControllerEvent(event);
+}
+
+static void QueueControllerPollEvent(int device, int action, int value, bool pending)
+{
+    controllerPollEvent_t* const events = pending ? controllerPendingPollEvents[device] : controllerPollEvents[device];
+    int& count = pending ? controllerPendingPollEventCounts[device] : controllerPollEventCounts[device];
+    if (count >= MAX_JOY_EVENT) return;
+    events[count].action = action;
+    events[count].value = value;
+    ++count;
+}
+
+static void AppendControllerPollEvent(int device, int action, int value)
+{
+    QueueControllerPollEvent(device, action, value, false);
+}
 
