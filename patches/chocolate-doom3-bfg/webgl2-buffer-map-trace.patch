         flushEnd = GetAllocedSize();
     }
     if (flushEnd > flushStart) {
+#if defined(__EMSCRIPTEN__)
+        WebPortTraceBuffer("joint", "flush", GL_UNIFORM_BUFFER, apiObject, flushStart, flushEnd - flushStart, GetAllocedSize(), IsMapped(), -1, WEBGL_BUFFER_WRITE_MAP_FLAGS, true, NULL);
+#endif
         qglFlushMappedBufferRange(GL_UNIFORM_BUFFER, flushStart, flushEnd - flushStart);
     }
-    if (!qglUnmapBufferARB(GL_UNIFORM_BUFFER)) {
+#if defined(__EMSCRIPTEN__)
+    WebPortTraceBuffer("joint", "unmap", GL_UNIFORM_BUFFER, apiObject, flushStart, flushEnd - flushStart, GetAllocedSize(), IsMapped(), -1, WEBGL_BUFFER_WRITE_MAP_FLAGS, true, NULL);
+#endif
+    const GLboolean unmapResult = qglUnmapBufferARB(GL_UNIFORM_BUFFER);
+#if defined(__EMSCRIPTEN__)
+    WebPortTraceBuffer("joint", "unmap-result", GL_UNIFORM_BUFFER, apiObject, flushStart, flushEnd - flushStart, GetAllocedSize(), IsMapped(), -1, WEBGL_BUFFER_WRITE_MAP_FLAGS, true, NULL, unmapResult);
+#endif
+    if (!unmapResult) {
         idLib::Printf("idJointBuffer::UnmapBuffer failed\n");
     }
 
