+static SDL_GameController* gameControllers[4] = {};
+static SDL_JoystickID gameControllerIds[4] = { -1, -1, -1, -1 };
+static bool gameControllerTriggers[4][2] = {};
+static sysEvent_t pendingControllerEvent = {};
+static bool hasPendingControllerEvent = false;
+
+static int FindGameControllerSlot(SDL_JoystickID instanceId)
+{
+    for (int slot = 0; slot < 4; ++slot) {
+        if (gameControllerIds[slot] == instanceId) return slot;
+    }
+    return -1;
+}
+
+static void OpenGameController(int deviceIndex)
+{
+    if (!SDL_IsGameController(deviceIndex)) return;
+    SDL_GameController* controller = SDL_GameControllerOpen(deviceIndex);
+    if (controller == NULL) return;
+    const SDL_JoystickID instanceId = SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller));
+    if (FindGameControllerSlot(instanceId) >= 0) {
+        SDL_GameControllerClose(controller);
+        return;
+    }
+    for (int slot = 0; slot < 4; ++slot) {
+        if (gameControllers[slot] == NULL) {
+            gameControllers[slot] = controller;
+            gameControllerIds[slot] = instanceId;
+            return;
+        }
+    }
+    SDL_GameControllerClose(controller);
+}
+
+static int GameControllerKey(SDL_GameControllerButton button)
+{
+    switch (button) {
+    case SDL_CONTROLLER_BUTTON_A: return K_JOY1;
+    case SDL_CONTROLLER_BUTTON_B: return K_JOY2;
+    case SDL_CONTROLLER_BUTTON_X: return K_JOY3;
+    case SDL_CONTROLLER_BUTTON_Y: return K_JOY4;
+    case SDL_CONTROLLER_BUTTON_LEFTSHOULDER: return K_JOY5;
+    case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: return K_JOY6;
+    case SDL_CONTROLLER_BUTTON_LEFTSTICK: return K_JOY7;
+    case SDL_CONTROLLER_BUTTON_RIGHTSTICK: return K_JOY8;
+    case SDL_CONTROLLER_BUTTON_START: return K_JOY9;
+    case SDL_CONTROLLER_BUTTON_BACK: return K_JOY10;
+    case SDL_CONTROLLER_BUTTON_DPAD_UP: return K_JOY_DPAD_UP;
+    case SDL_CONTROLLER_BUTTON_DPAD_DOWN: return K_JOY_DPAD_DOWN;
+    case SDL_CONTROLLER_BUTTON_DPAD_LEFT: return K_JOY_DPAD_LEFT;
+    case SDL_CONTROLLER_BUTTON_DPAD_RIGHT: return K_JOY_DPAD_RIGHT;
+    default: return 0;
+    }
+}
+#endif
 
