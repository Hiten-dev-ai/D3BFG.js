 void idCommonLocal::CompleteWipe()
 {
+#ifdef __EMSCRIPTEN__
+    const int webWipeStart = Sys_Milliseconds();
+    int webWipeIterations = 0;
+    common->Printf("[web-port map] CompleteWipe started remaining=%d ms\n", wipeStopTime - webWipeStart);
+#endif
     while (Sys_Milliseconds() < wipeStopTime) {
         BusyWait();
+#ifdef __EMSCRIPTEN__
+        webWipeIterations++;
+        if (webWipeIterations == 1 || webWipeIterations % 25 == 0) {
+            common->Printf("[web-port map] CompleteWipe BusyWait returned iterations=%d elapsed=%d ms\n",
+                webWipeIterations, Sys_Milliseconds() - webWipeStart);
+        }
+#endif
         Sys_Sleep(10);
+#ifdef __EMSCRIPTEN__
+        if (webWipeIterations == 1) {
+            common->Printf("[web-port map] CompleteWipe first sleep returned\n");
+        }
+#endif
     }
+#ifdef __EMSCRIPTEN__
+    common->Printf("[web-port map] CompleteWipe loop returned iterations=%d elapsed=%d ms\n",
+        webWipeIterations, Sys_Milliseconds() - webWipeStart);
+#endif
 
     // ensure it is completely faded out
     wipeStopTime = Sys_Milliseconds();
     BusyWait();
+#ifdef __EMSCRIPTEN__
+    common->Printf("[web-port map] CompleteWipe final BusyWait returned\n");
+#endif
 }
 
