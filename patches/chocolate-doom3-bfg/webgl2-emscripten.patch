+static int WebGLSourceBytesPerPixel(textureFormat_t format)
+{
+    switch (format) {
+    case FMT_ALPHA:
+    case FMT_LUM8:
+    case FMT_INT8:
+        return 1;
+    case FMT_L8A8:
+    case FMT_X16:
+    case FMT_RGB565:
+        return 2;
+    case FMT_Y16_X16:
