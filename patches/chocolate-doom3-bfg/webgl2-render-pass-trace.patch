 backEndState_t backEnd;
 
+static void RB_WebPortTracePassPixels(const char* passName, int numDrawSurfs)
+{
+#if defined(__EMSCRIPTEN__)
+	static int tracedFrames = 0;
+	if (!r_webPortPassTrace.GetBool() || tracedFrames >= 2 || numDrawSurfs < 60 || backEnd.viewDef == NULL || backEnd.viewDef->viewEntitys == NULL) {
+		return;
+	}
+
+	GLint framebuffer = -1;
+	GLint viewport[4] = { 0, 0, 0, 0 };
+	GLint scissor[4] = { 0, 0, 0, 0 };
+	GLboolean colorMask[4] = { GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE };
+	GLboolean depthMask = GL_FALSE;
+	qglGetIntegerv(GL_FRAMEBUFFER_BINDING, &framebuffer);
+	qglGetIntegerv(GL_VIEWPORT, viewport);
+	qglGetIntegerv(GL_SCISSOR_BOX, scissor);
+	qglGetBooleanv(GL_COLOR_WRITEMASK, colorMask);
+	qglGetBooleanv(GL_DEPTH_WRITEMASK, &depthMask);
+	const GLboolean scissorEnabled = qglIsEnabled(GL_SCISSOR_TEST);
+
+	const GLenum errorBeforeReadback = qglGetError();
+	const int sampleX[5] = { 1, 3, 1, 2, 3 };
+	const int sampleY[5] = { 1, 1, 3, 2, 3 };
+	GLubyte samples[5][4] = {};
+	for (int i = 0; i < 5; i++) {
+		const GLint x = viewport[0] + (viewport[2] * sampleX[i]) / 4;
+		const GLint y = viewport[1] + (viewport[3] * sampleY[i]) / 4;
+		if (viewport[2] > 0 && viewport[3] > 0) {
+			qglReadPixels(x, y, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, samples[i]);
+		}
+	}
+	const GLenum errorAfterReadback = qglGetError();
+	common->Printf("[web-port render] pass=%s draws=%d fbo=%d viewport=%d,%d,%d,%d scissor=%d:%d,%d,%d,%d colorMask=%d%d%d%d depthMask=%d samples=%d,%d,%d,%d|%d,%d,%d,%d|%d,%d,%d,%d|%d,%d,%d,%d|%d,%d,%d,%d glError=0x%x/0x%x\n",
+		passName, numDrawSurfs, framebuffer, viewport[0], viewport[1], viewport[2], viewport[3], (int)scissorEnabled, scissor[0], scissor[1], scissor[2], scissor[3],
+		(int)colorMask[0], (int)colorMask[1], (int)colorMask[2], (int)colorMask[3], (int)depthMask,
+		(int)samples[0][0], (int)samples[0][1], (int)samples[0][2], (int)samples[0][3],
+		(int)samples[1][0], (int)samples[1][1], (int)samples[1][2], (int)samples[1][3],
+		(int)samples[2][0], (int)samples[2][1], (int)samples[2][2], (int)samples[2][3],
+		(int)samples[3][0], (int)samples[3][1], (int)samples[3][2], (int)samples[3][3],
+		(int)samples[4][0], (int)samples[4][1], (int)samples[4][2], (int)samples[4][3], errorBeforeReadback, errorAfterReadback);
+	if (passName[0] == 's') {
+		tracedFrames++;
+	}
+#endif
+}
