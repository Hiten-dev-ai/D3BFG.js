# D3BFG.js server. Copy to .env. Never publish .env or data/.
# HTTP loopback works locally. For remote play, use an HTTPS reverse proxy and
# NODE_ENV=production (secure cookies). Never expose an HTTP login publicly.
HOST=127.0.0.1
PORT=8080
NODE_ENV=development

# Supply your legally owned DOOM 3 BFG Edition installation here. NO game data
# is included. Relative paths resolve from the server package root.
DOOM3BFG_GAME_DIR=./game
DOOM3BFG_ACCOUNTS_DIR=./data/accounts
DOOM3BFG_SYNC_DIR=./data/saves
DOOM3BFG_ENCODED_DIR=./data/encoded-assets

MULTIPLAYER_ENABLED=true
# Reuse precompressed game assets across authenticated clients on this server.
# Does not cache account/save APIs or share user data. Browser OPFS is per-origin.
SHARED_ASSET_CACHE=true

# Used ONLY when no account database exists. Change these before first start.
# No default password is accepted. At least 12 characters; use a unique secret.
# Remove FIRST_PASSWORD from .env after bootstrapping. Existing users are NEVER reset.
FIRST_USERNAME=Admin
FIRST_EMAIL=admin@example.com
FIRST_PASSWORD=

# Initial browser preferences; existing users' saved preferences take priority.
# Cache: 0=temporary, 1=current level, 2=visited levels, 3=all maps.
BROWSER_CACHE_MODE=1
BROWSER_PERSIST_SAVES=true
BROWSER_DEVELOPER_LEVELS=false
BROWSER_ENABLE_CONSOLE=false
BROWSER_SKIP_CINEMATICS=true
BROWSER_FRAME_RATE_CAP=60
